<Window x:Class="NotebookDoctor.WindowsToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ferramentas do Windows" Width="900" Height="680" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource OnSurface}"
        FontFamily="{StaticResource FontBody}" FontSize="{DynamicResource FsBody}" UseLayoutRounding="True"
        AutomationProperties.Name="Ferramentas do Windows">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Ferramentas do Windows" Style="{StaticResource TitleLarge}" AutomationProperties.HeadingLevel="Level1"/>
        <TextBlock Grid.Row="1" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,10"
                   Text="Atalhos para as ferramentas que o próprio Windows já traz. O Notebook Doctor só abre a ferramenta; se ela precisar de permissão de administrador, o Windows pergunta. Só aparecem as que existem neste computador."/>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel x:Name="Host" AutomationProperties.Name="Ferramentas disponíveis"/>
        </ScrollViewer>
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Fechar" IsCancel="True" IsDefault="True" Click="Close_Click"/>
            <TextBlock x:Name="Msg" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>
    </Grid>
</Window>
