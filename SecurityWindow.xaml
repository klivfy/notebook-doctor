<Window x:Class="NotebookDoctor.SecurityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verificar malware" Width="980" Height="780" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource OnSurface}"
        FontFamily="{StaticResource FontBody}" FontSize="{DynamicResource FsBody}" UseLayoutRounding="True"
        AutomationProperties.Name="Verificar malware">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Verificar malware" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1"/>
        <StackPanel Grid.Row="1" Margin="0,4,0,12">
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="Usa as ferramentas de segurança que já vêm no Windows: o Microsoft Defender e a Ferramenta de Remoção de Software Mal-Intencionado (MRT). Quem procura e remove é a Microsoft; o app mostra o resultado e registra em Ações."/>
            <!-- Quem protege o PC agora: neutro quando está tudo certo, com fundo de atenção quando algo pede ação antes de verificar -->
            <Border x:Name="StatusBox" CornerRadius="{StaticResource RadiusControl}" Padding="8,4" Margin="0,8,0,0" HorizontalAlignment="Left">
                <DockPanel>
                    <TextBlock x:Name="StatusGlyph" DockPanel.Dock="Left" Text="&#xE73E;" FontFamily="{StaticResource FontIcons}" FontSize="{DynamicResource FsIcon}"
                               Foreground="{DynamicResource Success}" VerticalAlignment="Top" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusLine" Style="{StaticResource Label}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- As duas ferramentas lado a lado, cada uma com o que faz e o que acontece com o que achar -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Microsoft Defender" Style="{StaticResource CardTitle}" AutomationProperties.HeadingLevel="Level2"/>
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="O antivírus do Windows. O que ele achar vai para a quarentena, como na Segurança do Windows, e dá para restaurar no Histórico de proteção."/>
                    <WrapPanel>
                        <Button x:Name="DefQuickBtn" Content="Verificação rápida" Click="DefenderQuick_Click" Margin="0,0,8,8"/>
                        <Button x:Name="DefFullBtn" Content="Verificação completa" Style="{StaticResource TonalButton}" Click="DefenderFull_Click" Margin="0,0,8,8"
                                ToolTip="Verifica todos os arquivos. Pode levar mais de uma hora."/>
                        <Button x:Name="DefFolderBtn" Content="Verificar uma pasta…" Style="{StaticResource TextButton}" Click="DefenderFolder_Click" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Ferramenta de Remoção de Software Mal-Intencionado" Style="{StaticResource CardTitle}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Procura as ameaças mais comuns e é atualizada todo mês pelo Windows Update. Ao terminar, o próprio MRT envia à Microsoft um relatório do que encontrou."/>
                    <WrapPanel>
                        <Button x:Name="MrtQuickBtn" Content="Verificar (só apontar)" Style="{StaticResource TonalButton}" Click="MrtQuick_Click" Margin="0,0,8,8"
                                ToolTip="Verificação rápida que só aponta o que achar, sem remover."/>
                        <Button x:Name="MrtFullBtn" Content="Completa (só apontar)" Style="{StaticResource TextButton}" Click="MrtFull_Click" Margin="0,0,8,8"
                                ToolTip="Verificação completa que só aponta. Pode levar horas."/>
                        <Button x:Name="MrtCleanBtn" Content="Verificar e remover…" Style="{StaticResource DangerButton}" Click="MrtClean_Click" Margin="0,0,8,8"
                                ToolTip="Verificação completa em que o MRT remove o que achar."/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Atualizar" Style="{StaticResource TextButton}" Click="History_Click"/>
                <TextBlock Text="Histórico de ameaças do Defender" Style="{StaticResource CardTitle}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2"/>
            </DockPanel>
            <Grid Grid.Row="1">
                <DataGrid x:Name="ThreatGrid" AutomationProperties.Name="Histórico de ameaças do Defender">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Quando" Binding="{Binding WhenText}" SortMemberPath="When" Width="110"/>
                        <DataGridTextColumn Header="Ameaça" Binding="{Binding Name}" Width="220"/>
                        <DataGridTextColumn Header="Gravidade" Binding="{Binding SeverityText}" SortMemberPath="Severity" Width="100"/>
                        <DataGridTextColumn Header="Situação" Binding="{Binding StatusText}" SortMemberPath="Status" Width="150"/>
                        <DataGridTextColumn Header="Arquivos" Binding="{Binding ResourcesText}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding ResourcesText}"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Style="{StaticResource EmptyState}" Tag="{Binding ElementName=ThreatGrid}"
                           Text="Nenhuma ameaça no histórico do Defender. Uma verificação rápida leva poucos minutos."/>
            </Grid>
            <TextBox x:Name="MrtOutput" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"
                     FontSize="{DynamicResource FsLabel}" Visibility="Collapsed" AutomationProperties.Name="Resultado do MRT"/>
        </Grid>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Fechar" IsCancel="True" Click="Close_Click" Style="{StaticResource TextButton}" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Abrir Segurança do Windows" Style="{StaticResource TextButton}" Click="OpenSecurity_Click" Margin="8,0,0,0"/>
            <Button x:Name="CancelBtn" DockPanel.Dock="Right" Content="Cancelar" Click="Cancel_Click" Style="{StaticResource TonalButton}" Visibility="Collapsed" Margin="8,0,0,0"/>
            <StackPanel>
                <ProgressBar x:Name="Bar" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed" AutomationProperties.Name="Andamento"/>
                <TextBlock x:Name="Msg" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
