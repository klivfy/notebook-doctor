{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klivfy.com/notebookdoctor/estatisticas.schema.json",
  "title": "Estatísticas de uso anônimas do Notebook Doctor",
  "description": "Corpo do POST de https://klivfy.com/notebookdoctor/estatisticas. Só existe se a pessoa ligou a opção em Configurações › Privacidade. Contagens por ferramenta, sem identificador de pessoa, computador ou instalação.",
  "type": "object",
  "additionalProperties": false,
  "required": ["app", "versao", "idioma", "windows", "semana", "usos", "falhas"],
  "properties": {
    "app": { "const": "NotebookDoctor" },
    "versao": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){1,3}$", "maxLength": 20 },
    "idioma": { "enum": ["pt", "en", "es"] },
    "windows": { "enum": ["10", "11"] },
    "semana": { "type": "string", "pattern": "^20[0-9]{2}-W(0[1-9]|[1-4][0-9]|5[0-3])$" },
    "usos": { "$ref": "#/$defs/contagens" },
    "falhas": { "$ref": "#/$defs/contagens" }
  },
  "$defs": {
    "contagens": {
      "type": "object",
      "propertyNames": { "enum": ["limpeza", "limpeza-avancada", "duplicados", "atualizacoes", "drivers", "inicializacao", "servicos", "tarefas", "extensoes", "programas", "energia", "backup", "seguranca", "recuperacao", "desfragmentar", "registro", "ferramentas-do-windows", "apagar-de-vez", "app"] },
      "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 100000 }
    }
  }
}
