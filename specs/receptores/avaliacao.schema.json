{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klivfy.com/notebookdoctor/avaliacao.schema.json",
  "title": "Avaliação do Notebook Doctor",
  "description": "Corpo do POST de https://klivfy.com/notebookdoctor/avaliacao. O app só envia depois que a pessoa clica em \"Enviar avaliação\" e confere este mesmo texto na tela.",
  "type": "object",
  "additionalProperties": false,
  "required": ["app", "versao", "idioma", "nota"],
  "properties": {
    "app": { "const": "NotebookDoctor" },
    "versao": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){1,3}$", "maxLength": 20 },
    "idioma": { "enum": ["pt", "en", "es"] },
    "nota": { "type": "integer", "minimum": 1, "maximum": 5 },
    "comentario": { "type": "string", "minLength": 1, "maxLength": 500 }
  }
}
