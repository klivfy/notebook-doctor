<Window x:Class="NotebookDoctor.MiniWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notebook Doctor · mini" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource FontBody}" FontSize="{DynamicResource FsLabel}"
        Foreground="{DynamicResource OnSurface}" UseLayoutRounding="True"
        MouseLeftButtonDown="Drag" MouseDoubleClick="Open" KeyDown="Window_KeyDown"
        AutomationProperties.Name="Mini-widget do Notebook Doctor">
    <Border Background="{DynamicResource SurfaceContainer}" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1"
            CornerRadius="12" Padding="14,10,8,12" Margin="8" Width="230">
        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.28"/></Border.Effect>
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Abrir painel" Click="Open"/>
                <MenuItem Header="Fechar mini-widget" Click="Close_Click"/>
            </ContextMenu>
        </Border.ContextMenu>
        <StackPanel>
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="&#xE711;" Style="{StaticResource IconButton}" Width="28" Height="28"
                        FontSize="10" Margin="0" AutomationProperties.Name="Fechar mini-widget" ToolTip="Fechar (Esc)" Click="Close_Click"/>
                <TextBlock x:Name="ScoreText" Text="Nota –" FontFamily="{StaticResource FontMedium}" VerticalAlignment="Center"
                           ToolTip="Clique duplo abre o painel; arraste para mover"/>
            </DockPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="CPU" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,3,10,3"/>
                <ProgressBar x:Name="CpuBar" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Processador"/>
                <TextBlock x:Name="CpuText" Grid.Column="2" Text="–" TextAlignment="Right" FontFamily="{StaticResource FontMedium}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Grid.Row="1" Text="Memória" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,3,10,3"/>
                <ProgressBar x:Name="RamBar" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Memória"/>
                <TextBlock x:Name="RamText" Grid.Row="1" Grid.Column="2" Text="–" TextAlignment="Right" FontFamily="{StaticResource FontMedium}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Grid.Row="2" Text="Disco" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,3,10,3"/>
                <ProgressBar x:Name="DiskBar" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Atividade do disco"/>
                <TextBlock x:Name="DiskText" Grid.Row="2" Grid.Column="2" Text="–" TextAlignment="Right" FontFamily="{StaticResource FontMedium}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            </Grid>
            <TextBlock x:Name="TopText" Style="{StaticResource Muted}" Margin="0,6,6,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Border>
</Window>
