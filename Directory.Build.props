<Project>

  <!-- ARC-06: governança centralizada de compilação, nulabilidade e análise estática em toda a solução -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Edição da Microsoft Store: dotnet build -p:StoreBuild=true (ver packaging/store/LEIA-ME.md) -->
  <PropertyGroup Condition="'$(StoreBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);STORE</DefineConstants>
  </PropertyGroup>

</Project>
