<Window x:Class="NotebookDoctor.NetworkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NotebookDoctor"
        Title="Rede e internet" Width="960" Height="720" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackdrop}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource FontBody}" FontSize="{DynamicResource FsBody}" UseLayoutRounding="True"
        AutomationProperties.Name="Rede e internet">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Margin="24">
        <TextBlock Text="Rede e internet" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1"/>
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,16"
                   Text="Para quando o Wi-Fi diz conectado, mas nada abre: o app testa cada etapa da conexão, mostra onde ela quebra e aplica só a correção daquela etapa. Os testes só acontecem quando você clica."/>

        <TextBlock Text="Conectado, mas não navega" Style="{StaticResource CardTitle}" AutomationProperties.HeadingLevel="Level2"/>
        <TextBlock x:Name="StepsInfo" TextWrapping="Wrap" LineHeight="24" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock x:Name="FixInfo" TextWrapping="Wrap" FontFamily="{StaticResource FontMedium}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
        <WrapPanel Margin="0,12,0,0">
            <Button x:Name="CheckBtn" Content="Testar a conexão" Click="Check_Click" Margin="0,0,8,8"/>
            <Button x:Name="FixBtn" Content="Corrigir" Style="{StaticResource TonalButton}" Click="Fix_Click" Margin="0,0,8,8" Visibility="Collapsed"/>
        </WrapPanel>

        <TextBlock Text="DNS mais rápido" Style="{StaticResource CardTitle}" Margin="0,16,0,8" AutomationProperties.HeadingLevel="Level2"/>
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="O DNS traduz o nome dos sites em endereços. Um DNS lento atrasa o começo de cada página. O teste compara o seu com Cloudflare, Google e Quad9 (alguns segundos). Trocar exige o app como administrador, e o de antes fica guardado em Ações."/>
        <TextBlock x:Name="DnsInfo" TextWrapping="Wrap" LineHeight="24" AutomationProperties.LiveSetting="Polite"/>
        <WrapPanel Margin="0,12,0,0">
            <Button x:Name="DnsBtn" Content="Comparar DNS" Style="{StaticResource TonalButton}" Click="Dns_Click" Margin="0,0,8,8"/>
            <Button x:Name="DnsUseBtn" Content="Usar o mais rápido…" Style="{StaticResource TonalButton}" Click="DnsUse_Click" Margin="0,0,8,8" Visibility="Collapsed"/>
            <Button x:Name="DnsAutoBtn" Content="Voltar ao DNS automático…" Style="{StaticResource TextButton}" Click="DnsAuto_Click" Margin="0,0,8,8" Visibility="Collapsed"/>
        </WrapPanel>

        <TextBlock Text="Wi-Fi e adaptadores" Style="{StaticResource CardTitle}" Margin="0,16,0,8" AutomationProperties.HeadingLevel="Level2"/>
        <TextBlock x:Name="WifiInfo" TextWrapping="Wrap" LineHeight="24" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock x:Name="VpnInfo" TextWrapping="Wrap" LineHeight="24" Margin="0,8,0,0"/>
        <WrapPanel Margin="0,12,0,0">
            <Button x:Name="DevicesBtn" Content="Abrir o Gerenciador de Dispositivos" Style="{StaticResource TextButton}" Click="Devices_Click" Margin="0,0,8,8" Visibility="Collapsed"
                    ToolTip="Em Exibir › Mostrar dispositivos ocultos, os adaptadores de VPNs antigas ficam em Adaptadores de rede; clique com o botão direito › Desinstalar dispositivo."/>
            <Button Content="Fechar" Style="{StaticResource TextButton}" IsCancel="True" Click="Close_Click" Margin="0,0,8,8"/>
        </WrapPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
