<Window x:Class="NotebookDoctor.FileUnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NotebookDoctor"
        Title="Destravar arquivo ou pendrive" Width="980" Height="680" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Background="{DynamicResource WindowBackdrop}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource FontBody}" FontSize="{DynamicResource FsBody}" UseLayoutRounding="True"
        AutomationProperties.Name="Destravar arquivo ou pendrive">
    <ScrollViewer local:FitScroll.StarMin="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Quem está usando este arquivo?" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1"/>
        <TextBlock Grid.Row="1" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"
                   Text="Quando o Windows diz que um arquivo, uma pasta ou um pendrive está em uso, escolha-o aqui (ou solte-o nesta janela) para ver quais programas o seguram. Fechar um programa pede confirmação; programas do sistema e serviços nunca são encerrados."/>
        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
            <Button Content="Escolher arquivo…" Style="{StaticResource TonalButton}" Click="PickFile_Click" Margin="0,0,8,8"/>
            <Button Content="Escolher pasta…" Style="{StaticResource TonalButton}" Click="PickFolder_Click" Margin="0,0,8,8"/>
            <ComboBox x:Name="Drives" Width="240" Margin="0,0,8,8" AutomationProperties.Name="Unidade" DisplayMemberPath="Label"/>
            <Button Content="Verificar unidade" Style="{StaticResource TonalButton}" Click="CheckDrive_Click" Margin="0,0,8,8"/>
            <TextBlock x:Name="Target" Style="{StaticResource Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,8"
                       AutomationProperties.LiveSetting="Polite"/>
        </WrapPanel>
        <Grid Grid.Row="3">
            <DataGrid x:Name="Grid" SelectionMode="Single" AutomationProperties.Name="Programas que usam o item escolhido" PreviewKeyDown="Grid_KeyDown">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Programa" Width="1.4*" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80"/>
                    <DataGridTextColumn Header="Janela ou serviço" Binding="{Binding Title}" Width="1.4*"/>
                    <DataGridTextColumn Header="O que fazer" Binding="{Binding VerdictText}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="Empty" Style="{StaticResource EmptyState}" Tag="{Binding ElementName=Grid}"
                       Text="Escolha um arquivo, uma pasta ou uma unidade, ou solte-o nesta janela."/>
        </Grid>
        <TextBlock x:Name="Info" Grid.Row="4" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="4,8,0,0" AutomationProperties.LiveSetting="Polite"/>
        <WrapPanel Grid.Row="5" Margin="0,12,0,0">
            <Button x:Name="CloseProgramBtn" Content="Fechar programa…" Style="{StaticResource DangerButton}" Click="CloseProgram_Click" Margin="0,0,8,8"/>
            <Button x:Name="RestartExplorerBtn" Content="Reiniciar o Explorador…" Style="{StaticResource TonalButton}" Click="RestartExplorer_Click" Margin="0,0,8,8"/>
            <Button x:Name="EjectBtn" Content="Ejetar unidade" Style="{StaticResource TonalButton}" Click="Eject_Click" Margin="0,0,8,8"/>
            <Button Content="Verificar de novo" Style="{StaticResource TextButton}" Click="Recheck_Click" Margin="0,0,8,8"/>
            <Button Content="Fechar" Style="{StaticResource TextButton}" IsCancel="True" Click="Close_Click" Margin="0,0,8,8"/>
        </WrapPanel>
    </Grid>
    </ScrollViewer>
</Window>
