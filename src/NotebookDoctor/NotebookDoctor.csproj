<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <!-- O alvo 22000 vem do projeto do motor COM do WinGet; o app continua abrindo no Windows 10 (sem ele, a reserva em linha de comando cuida do catálogo) -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>NotebookDoctor</AssemblyName>
    <RootNamespace>NotebookDoctor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>Notebook Doctor</Product>
    <Company>Klivfy Tecnologia e Consultoria em TI LTDA</Company>
    <Copyright>© 2026 Klivfy Tecnologia e Consultoria em TI LTDA. Todos os direitos reservados.</Copyright>
    <Description>Monitor de desempenho, limpeza segura e diagnóstico para Windows</Description>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- R4: o app fica em src/NotebookDoctor, ao lado da biblioteca (Core) e do que fala com o Windows (Windows) -->
    <ProjectReference Include="../NotebookDoctor.Core/NotebookDoctor.Core.csproj" />
    <ProjectReference Include="../NotebookDoctor.Windows/NotebookDoctor.Windows.csproj" />
    <ProjectReference Include="../NotebookDoctor.WinGetCom/NotebookDoctor.WinGetCom.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Uma parte do MainWindow por aba; aparecem agrupadas sob MainWindow.xaml no Visual Studio -->
    <Compile Update="MainWindow.*.cs" DependentUpon="MainWindow.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="icon-256.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Google Sans Flex (SIL OFL) embutida no executável: o app não depende da fonte instalada -->
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- B23/B24: novidades, licenças e "Seus dados" mostrados no Sobre, sem depender de internet -->
    <EmbeddedResource Include="Textos\*.txt" LogicalName="Textos.%(Filename).txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms só é usado para o NotifyIcon da bandeja; evita ambiguidade com WPF -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
