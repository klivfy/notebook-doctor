<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fluent · tema escuro.
         Valores dos recursos de tema públicos do WinUI (Fluent, licença MIT), convertidos para cores sólidas. Os nomes são os papéis
         (WindowBackdrop, Accent, Critical…); os contrastes são conferidos por ThemeContrastTests. -->

    <!-- Planos: moldura (Mica; sólido sem ela) → camada de conteúdo → cartão -->
    <SolidColorBrush x:Key="WindowBackdrop" Color="#202020"/>
    <SolidColorBrush x:Key="LayerFill" Color="#272727"/>
    <SolidColorBrush x:Key="LayerStroke" Color="#1D1D1D"/>
    <SolidColorBrush x:Key="CardFill" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="CardStroke" Color="#1D1D1D"/>
    <SolidColorBrush x:Key="SurfaceVariant" Color="#333333"/>

    <!-- Texto e contornos -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#CFCFCF"/>
    <SolidColorBrush x:Key="Outline" Color="#9E9E9E"/>
    <SolidColorBrush x:Key="OutlineVariant" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="FocusStroke" Color="#FFFFFF"/>

    <!-- Preenchimentos de controle e camadas de estado -->
    <SolidColorBrush x:Key="StateHover" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="StatePressed" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="ControlFill" Color="#373737"/>
    <SolidColorBrush x:Key="ControlFillHover" Color="#3E3E3E"/>
    <SolidColorBrush x:Key="ControlStroke" Color="#454545"/>

    <!-- Destaque (ação, seleção) e texto de destaque (valores clicáveis) -->
    <SolidColorBrush x:Key="Accent" Color="#60CDFF"/>
    <SolidColorBrush x:Key="OnAccent" Color="#000000"/>
    <SolidColorBrush x:Key="AccentText" Color="#99EBFF"/>
    <SolidColorBrush x:Key="AccentContainer" Color="#1F3442"/>
    <SolidColorBrush x:Key="OnAccentContainer" Color="#99EBFF"/>
    <SolidColorBrush x:Key="SecondaryContainer" Color="#373737"/>
    <SolidColorBrush x:Key="OnSecondaryContainer" Color="#FFFFFF"/>

    <!-- Estados: cor do texto/ícone, texto sobre ela e fundo suave (como o InfoBar do Windows) -->
    <SolidColorBrush x:Key="Critical" Color="#FF99A4"/>
    <SolidColorBrush x:Key="OnCritical" Color="#000000"/>
    <SolidColorBrush x:Key="CriticalContainer" Color="#442726"/>
    <SolidColorBrush x:Key="Caution" Color="#FCE100"/>
    <SolidColorBrush x:Key="OnCaution" Color="#000000"/>
    <SolidColorBrush x:Key="CautionContainer" Color="#433519"/>
    <SolidColorBrush x:Key="Success" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="OnSuccess" Color="#000000"/>
    <SolidColorBrush x:Key="SuccessContainer" Color="#393D1B"/>
    <SolidColorBrush x:Key="InfoContainer" Color="#1F3442"/>

    <!-- Superfície inversa (aviso flutuante) -->
    <SolidColorBrush x:Key="InverseSurface" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="InverseOnSurface" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="InversePrimary" Color="#005FB8"/>

    <!-- Séries dos gráficos: nenhuma usa o destaque nem as cores de estado -->
    <SolidColorBrush x:Key="ChartCpu" Color="#B4A0FF"/>
    <SolidColorBrush x:Key="ChartRam" Color="#FF8CC8"/>
    <SolidColorBrush x:Key="ChartDisk" Color="#A0A0A0"/>

    <!-- Escala de carga das barras (livre → crítico) -->
    <SolidColorBrush x:Key="LevelLow" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="LevelMid" Color="#FCE100"/>
    <SolidColorBrush x:Key="LevelHigh" Color="#FF9D3D"/>
    <SolidColorBrush x:Key="LevelCrit" Color="#FF99A4"/>

    <!-- Código QR: preto no branco nos dois temas, porque muitas câmeras não leem o QR invertido -->
    <SolidColorBrush x:Key="QrLight" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="QrDark" Color="#000000"/>
</ResourceDictionary>
