<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:NotebookDoctor"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Cada dicionário traz os tokens: o StaticResource só enxerga o próprio dicionário e os que ele inclui -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Título de página (28 px semibold, como as telas do Windows 11) -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontTitle}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsPageTitle}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsCardTitle}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FsLabel}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <!-- U7: estado vazio de uma tabela. Tag aponta para a tabela; o texto aparece no meio dela enquanto não houver linhas -->
    <Style x:Key="EmptyState" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxWidth" Value="360"/>
        <Setter Property="Margin" Value="16,48,16,16"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag.HasItems, RelativeSource={RelativeSource Self}}" Value="False">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsCardTitle}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ============ Aviso em linha (InfoBar do Windows): faixa dentro da tela, que fica enquanto o assunto vale ============ -->
    <!-- A cor só reforça: o texto do aviso sempre diz o que está acontecendo. O aviso que some sozinho é o Snack da janela principal. -->
    <Style x:Key="InfoBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SecondaryContainer}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="InfoBarWarning" TargetType="Border" BasedOn="{StaticResource InfoBar}">
        <Setter Property="Background" Value="{DynamicResource CautionContainer}"/>
    </Style>
    <Style x:Key="InfoBarError" TargetType="Border" BasedOn="{StaticResource InfoBar}">
        <Setter Property="Background" Value="{DynamicResource CriticalContainer}"/>
    </Style>
    <Style x:Key="InfoBarSuccess" TargetType="Border" BasedOn="{StaticResource InfoBar}">
        <Setter Property="Background" Value="{DynamicResource SuccessContainer}"/>
    </Style>

    <!-- ============ Cartão (Fluent: canto de 8 px, contorno de 1 px, sem sombra) ============ -->
    <!-- B15: densidade. App.ApplyDensity troca estes valores no modo compacto (Density, no Core). -->
    <Thickness x:Key="CardPad">16</Thickness>
    <Thickness x:Key="CardGap">4</Thickness>
    <sys:Double x:Key="RowMin">40</sys:Double>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
        <Setter Property="Padding" Value="{DynamicResource CardPad}"/>
        <Setter Property="Margin" Value="{DynamicResource CardGap}"/>
    </Style>



    <!-- ============ Navegação (NavigationView do Windows 11) ============
         Três formas, escolhidas pelo Tag da lista: "rail" = trilho de 80 px com ícone sobre o rótulo curto (padrão);
         vazio = lateral larga com ícone e texto; "compact" = só ícones (janela estreita no modo largo).
         Itens empilhados no topo; o item com DockPanel.Dock="Bottom" (Configurações) fica no rodapé. -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="DockPanel.Dock" Value="Top"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingPill}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid x:Name="Root" Background="Transparent" MinHeight="40">
                        <Border x:Name="Pill" CornerRadius="{StaticResource RadiusControl}" Background="Transparent"/>
                        <Border x:Name="Hover" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource StateHover}" Opacity="0"/>
                        <Border x:Name="Bar" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" Margin="0,0,0,0"
                                Background="{DynamicResource Accent}" Visibility="Collapsed"/>
                        <!-- Largo e compacto: ícone ao lado do texto -->
                        <StackPanel x:Name="Wide" Orientation="Horizontal" Margin="14,8,16,8" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontFamily="{StaticResource FontIcons}" FontSize="{DynamicResource FsIcon}"
                                           VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                <Ellipse x:Name="DotWide" Width="7" Height="7" Fill="{DynamicResource Caution}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Margin="0,-3,-5,0" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter x:Name="Text" Margin="14,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                        <!-- Trilho: ícone sobre o rótulo curto -->
                        <StackPanel x:Name="Tall" Margin="4,8,4,7" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <Grid HorizontalAlignment="Center">
                                <TextBlock x:Name="GlyphTall" Text="{TemplateBinding Tag}" FontFamily="{StaticResource FontIcons}" FontSize="{DynamicResource FsIconLarge}"
                                           HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Caution}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Margin="0,-2,-6,0" Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock x:Name="ShortText" Text="{Binding (local:NavLabel.Short), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontSize="{DynamicResource FsCaption}" Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="72" Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource StateHover}"/>
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentText}"/>
                            <Setter TargetName="GlyphTall" Property="Foreground" Value="{DynamicResource AccentText}"/>
                            <Setter TargetName="ShortText" Property="Foreground" Value="{DynamicResource AccentText}"/>
                            <Setter TargetName="ShortText" Property="FontFamily" Value="{StaticResource FontSemi}"/>
                        </Trigger>
                        <Trigger Property="local:NavLabel.Badge" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="DotWide" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="compact">
                            <Setter TargetName="Text" Property="Visibility" Value="Collapsed"/>
                            <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="rail">
                            <Setter TargetName="Wide" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Tall" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Root" Property="MinHeight" Value="56"/>
                            <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NavList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value><ItemsPanelTemplate><DockPanel LastChildFill="False"/></ItemsPanelTemplate></Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <!-- B46: em janela baixa (notebook a 150%), as seções que não cabem rolam em vez de sumir -->
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Ladrilho (Painel): cartão inteiro clicável, com título, ícone no canto, rótulo e valor em destaque ============ -->
    <Style x:Key="TileButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource CardFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Margin" Value="{DynamicResource CardGap}"/>
        <Setter Property="MinHeight" Value="112"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}"/>
                        <Border x:Name="Layer" Background="{DynamicResource StateHover}" CornerRadius="{StaticResource RadiusCard}" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Layer" Property="Opacity" Value="1"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Layer" Property="Opacity" Value="0.6"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Cartão-linha (ActionRow, como os cartões de Configurações do Windows) ============
         Ícone no Tag, título no Content, descrição no ToolTip (mostrada no cartão, sem balão) e a seta de "abre outra tela". O cartão
         inteiro é o botão: teclado e Narrador o tratam como um. -->
    <Style x:Key="ActionRow" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource CardFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Margin" Value="{DynamicResource CardGap}"/>
        <Setter Property="MinHeight" Value="64"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="ToolTipService.IsEnabled" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}"/>
                        <Border x:Name="Layer" Background="{DynamicResource StateHover}" CornerRadius="{StaticResource RadiusCard}" Opacity="0"/>
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource FontIcons}" FontSize="{DynamicResource FsIconLarge}" VerticalAlignment="Center" Margin="2,0,14,0"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <ContentPresenter TextElement.FontFamily="{StaticResource FontSemi}"/>
                                <TextBlock Text="{Binding ToolTip, RelativeSource={RelativeSource TemplatedParent}}" FontSize="{DynamicResource FsLabel}"
                                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource FontIcons}" FontSize="12" VerticalAlignment="Center" Margin="12,0,2,0"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Layer" Property="Opacity" Value="1"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Layer" Property="Opacity" Value="0.6"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Título de grupo acima de uma lista de cartões-linha -->
    <Style x:Key="GroupTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSemi}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Margin" Value="6,14,0,4"/>
    </Style>

    <!-- ============ Camada de conteúdo (o plano entre a moldura com Mica e os cartões) ============ -->
    <Style x:Key="ContentLayer" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LayerFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LayerStroke}"/>
        <Setter Property="BorderThickness" Value="1,1,0,0"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLayer}"/>
    </Style>

    <!-- ============ Conteúdo das seções ============
         TabControl sem cabeçalhos (a navegação é a barra lateral). PART_SelectedContentHost é o nome que o
         TabControl usa para expor o conteúdo da aba ao Narrador e à UI Automation. -->
    <!-- O conteúdo de cada seção herda a cor do TabItem (pai lógico): sem isso vem o preto do sistema e some no tema escuro -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style TargetType="TabControl">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <TabPanel IsItemsHost="True" Visibility="Collapsed"/>
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="{TemplateBinding Padding}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
