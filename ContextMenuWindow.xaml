<Window x:Class="NotebookDoctor.ContextMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Menu de contexto" Width="1100" Height="720" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceContainer}" Foreground="{DynamicResource OnSurface}"
        FontFamily="{StaticResource FontBody}" FontSize="{DynamicResource FsBody}" UseLayoutRounding="True"
        AutomationProperties.Name="Menu de contexto">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Menu de contexto" Style="{StaticResource TitleMedium}" AutomationProperties.HeadingLevel="Level1"/>
        <TextBlock Grid.Row="1" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,10"
                   Text="O que aparece ao clicar com o botão direito em arquivos, pastas e unidades. Desativar um verbo só o esconde do menu. Desativar um manipulador guarda um backup da chave e a apaga; reativar devolve tudo. O que é do Windows não pode ser desativado aqui. Os itens do menu novo do Windows 11 que vêm de apps da Store não ficam no registro e não aparecem."/>
        <DataGrid x:Name="Grid" Grid.Row="2" AutomationProperties.Name="Itens do menu de contexto" SelectionMode="Single" MouseDoubleClick="Reveal_Click">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Item" Binding="{Binding Display}" Width="2*"/>
                <DataGridTextColumn Header="Onde aparece" Binding="{Binding Where}" Width="1.1*"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding KindText}" Width="110"/>
                <DataGridTextColumn Header="Fabricante" Binding="{Binding Publisher}" Width="1.5*"/>
                <DataGridTextColumn Header="Arquivo" Binding="{Binding FileText}" Width="2*"/>
                <DataGridTextColumn Header="Origem" Binding="{Binding Origin}" Width="90"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding StateText}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="Info" Grid.Row="3" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="4,8,0,0" AutomationProperties.LiveSetting="Polite"/>
        <WrapPanel Grid.Row="4" Margin="0,10,0,0">
            <Button x:Name="DisableBtn" Content="Desativar" Click="Disable_Click" Margin="0,0,8,6"/>
            <Button x:Name="EnableBtn" Content="Reativar" Style="{StaticResource TonalButton}" Click="Enable_Click" Margin="0,0,8,6"/>
            <Button Content="Mostrar na pasta" Style="{StaticResource TextButton}" Click="Reveal_Click" Margin="0,0,8,6"/>
            <Button Content="Atualizar" Style="{StaticResource TextButton}" Click="Reload_Click" Margin="0,0,8,6"/>
            <CheckBox x:Name="ShowWindows" Content="Mostrar itens do Windows" Click="ShowWindows_Click" VerticalAlignment="Center" Margin="8,0,8,6"/>
            <Button Content="Fechar" Style="{StaticResource TextButton}" IsCancel="True" Click="Close_Click" Margin="0,0,8,6"/>
            <TextBlock x:Name="Msg" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,0,0,6" AutomationProperties.LiveSetting="Polite"/>
        </WrapPanel>
    </Grid>
</Window>
