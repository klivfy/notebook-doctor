<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Material 3 · tema escuro. Base #121212, texto #ffffff, primária #00bcf2, séries #00b294/#ec008c, destaque #1ed760. -->
    <SolidColorBrush x:Key="Surface" Color="#121212"/>
    <SolidColorBrush x:Key="SurfaceContainer" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="SurfaceVariant" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="OnSurface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OnSurfaceVariant" Color="#B8B8B8"/>
    <SolidColorBrush x:Key="Outline" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="OutlineVariant" Color="#3A3A3A"/>
    <!-- Contorno dos cartões: invisível aqui; no Alto Contraste vira a cor do texto -->
    <SolidColorBrush x:Key="CardBorder" Color="Transparent"/>
    <SolidColorBrush x:Key="StateHover" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="InverseSurface" Color="#F2F2F9"/>
    <SolidColorBrush x:Key="InverseOnSurface" Color="#121212"/>
    <SolidColorBrush x:Key="InversePrimary" Color="#00188F"/>

    <SolidColorBrush x:Key="Primary" Color="#00BCF2"/>
    <SolidColorBrush x:Key="OnPrimary" Color="#000000"/>
    <SolidColorBrush x:Key="PrimaryContainer" Color="#0E343F"/>
    <SolidColorBrush x:Key="OnPrimaryContainer" Color="#00BCF2"/>
    <SolidColorBrush x:Key="SecondaryContainer" Color="#0E343F"/>
    <SolidColorBrush x:Key="RowSelected" Color="#0E343F"/>
    <SolidColorBrush x:Key="RowSelectedBorder" Color="Transparent"/>
    <SolidColorBrush x:Key="OnSecondaryContainer" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Error" Color="#E81123"/>
    <SolidColorBrush x:Key="OnError" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Warning" Color="#FF8C00"/>
    <SolidColorBrush x:Key="OnWarning" Color="#000000"/>
    <SolidColorBrush x:Key="Success" Color="#1ED760"/>
    <SolidColorBrush x:Key="OnSuccess" Color="#000000"/>

    <SolidColorBrush x:Key="ChartCpu" Color="#00B294"/>
    <SolidColorBrush x:Key="ChartRam" Color="#EC008C"/>
    <SolidColorBrush x:Key="ChartDisk" Color="#B8B8B8"/>

    <SolidColorBrush x:Key="LevelLow" Color="#BAD80A"/>
    <SolidColorBrush x:Key="LevelMid" Color="#FFF100"/>
    <SolidColorBrush x:Key="LevelHigh" Color="#FF8C00"/>
    <SolidColorBrush x:Key="LevelCrit" Color="#E81123"/>
</ResourceDictionary>
