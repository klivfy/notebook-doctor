<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============ Tipografia · Google Sans Flex (embutida em /Fonts) ============ -->
    <FontFamily x:Key="FontBody">/Fonts/#Google Sans Flex 9pt 9pt, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMedium">/Fonts/#Google Sans Flex 9pt 9pt Medium, Segoe UI</FontFamily>
    <FontFamily x:Key="FontSemi">/Fonts/#Google Sans Flex 9pt 9pt SemiBold, Segoe UI</FontFamily>
    <FontFamily x:Key="FontDisplay">/Fonts/#Google Sans Flex 36pt 36pt SemiBold, Segoe UI</FontFamily>
    <FontFamily x:Key="FontIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Tamanhos em px a 100%. TextScale.Apply multiplica pelo "Tamanho do texto" do Windows (Acessibilidade). -->
    <sys:Double x:Key="FsLabel">13</sys:Double>
    <sys:Double x:Key="FsBody">14</sys:Double>
    <sys:Double x:Key="FsTitleMedium">16</sys:Double>
    <sys:Double x:Key="FsTitle">20</sys:Double>
    <sys:Double x:Key="FsTitleLarge">22</sys:Double>
    <sys:Double x:Key="FsDisplay">40</sys:Double>
    <sys:Double x:Key="FsHero">56</sys:Double>

    <Style x:Key="Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsDisplay}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    </Style>
    <Style x:Key="TitleLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsTitleLarge}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    </Style>
    <Style x:Key="TitleMedium" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsTitleMedium}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FsLabel}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsTitleMedium}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ============ Anel de foco do teclado ============
         O WPF só mostra o FocusVisualStyle quando o foco chega pelo teclado (Tab, setas), nunca por clique. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Primary}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FocusRingPill">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="24" BorderThickness="2" BorderBrush="{DynamicResource Primary}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FocusRingTight">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="1" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource Primary}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Cartão tonal (M3 filled card) ============ -->
    <!-- B15: densidade. App.ApplyDensity troca estes valores no modo compacto (Density, no Core). -->
    <Thickness x:Key="CardPad">20</Thickness>
    <Thickness x:Key="CardGap">6</Thickness>
    <sys:Double x:Key="RowMin">40</sys:Double>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainer}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="{DynamicResource CardPad}"/>
        <Setter Property="Margin" Value="{DynamicResource CardGap}"/>
    </Style>

    <!-- ============ Botões: preenchido (padrão), tonal, texto, perigo ============ -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource Primary}"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingPill}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="20" MinHeight="40"/>
                        <Border x:Name="Layer" Background="{TemplateBinding Foreground}" CornerRadius="20" Opacity="0"/>
                        <ContentPresenter Margin="24,8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Layer" Property="Opacity" Value="0.10"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Layer" Property="Opacity" Value="0.18"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TonalButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource SecondaryContainer}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}"/>
    </Style>
    <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Error}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnError}"/>
    </Style>
    <!-- Botão só com ícone (fechar aviso): 40×40 e nome acessível obrigatório via AutomationProperties.Name -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
        <Setter Property="FontFamily" Value="{StaticResource FontIcons}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Width="40" Height="40">
                        <Ellipse x:Name="Layer" Fill="{TemplateBinding Foreground}" Opacity="0"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Layer" Property="Opacity" Value="0.10"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Layer" Property="Opacity" Value="0.18"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "Por que isso importa?": link que abre/fecha a explicação logo abaixo (M15) -->
    <Style x:Key="WhyToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsLabel}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent" MinHeight="28">
                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <TextBlock x:Name="Chevron" Text="&#xE70D;" FontFamily="{StaticResource FontIcons}" FontSize="10" Margin="6,2,0,0"
                                   VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="&#xE70E;"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Caixa de seleção ============ -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Width="40" Height="40" VerticalAlignment="Top">
                            <Ellipse x:Name="Hover" Fill="{DynamicResource Primary}" Opacity="0"/>
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="2" BorderThickness="2"
                                    BorderBrush="{DynamicResource OnSurfaceVariant}" Background="Transparent">
                                <Path x:Name="Mark" Data="M2,7 L6,11 L13,3" Stroke="{DynamicResource OnPrimary}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-2,-2,0,0"/>
                            </Border>
                        </Grid>
                        <!-- Texto quebra linha: com o texto ampliado do Windows, a opção não é cortada -->
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="2,9,8,9">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.12"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Primary}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Primary}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GridCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============ Campo de texto (outlined) ============
         O próprio contorno vira 2 px na cor primária com o foco: dispensa o anel extra. -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Primary}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Primary}"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Outline}" Background="Transparent">
                        <Grid>
                            <!-- Texto de ajuda (placeholder): vem do Tag e some quando há texto -->
                            <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource OnSurfaceVariant}" IsHitTestVisible="False" Visibility="Collapsed"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value=""/>
                                <Condition Property="IsKeyboardFocused" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource OnSurface}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Primary}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ ComboBox (menu suspenso) ============ -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Padding="16,11" Background="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryContainer}"/></Trigger>
                        <!-- Depois do selecionado: o item sob o mouse ou o teclado sempre aparece -->
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource StateHover}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" Cursor="Hand"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Outline}" Background="Transparent">
                                        <Path Data="M0,0 L5,5 L10,0" Stroke="{DynamicResource OnSurfaceVariant}" StrokeThickness="2"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource OnSurface}"/></Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Primary}"/>
                                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="14,8,36,8" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               PopupAnimation="Fade" Focusable="False" VerticalOffset="4">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Background="{DynamicResource SurfaceVariant}" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1"
                                    CornerRadius="8" Padding="0,6" Margin="0,0,8,8">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3"/></Border.Effect>
                                <ItemsPresenter/>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Barras de rolagem finas ============ -->
    <Style x:Key="ScrollRepeat" TargetType="RepeatButton">
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" Background="{DynamicResource OnSurfaceVariant}" Opacity="0.45" CornerRadius="4" Margin="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Opacity" Value="0.8"/></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="T" Property="Opacity" Value="1"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="VScrollTemplate" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollRepeat}"/></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollRepeat}"/></Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="HScrollTemplate" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollRepeat}"/></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollRepeat}"/></Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Template" Value="{StaticResource VScrollTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="Template" Value="{StaticResource HScrollTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ Navegação lateral (padrão NavigationView do Windows 11) ============
         Itens empilhados no topo; o item com DockPanel.Dock="Bottom" (Configurações) fica no rodapé.
         Com Tag="compact" na lista, só os ícones aparecem e o nome vai para a dica. -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="DockPanel.Dock" Value="Top"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingPill}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent" MinHeight="44">
                        <Border x:Name="Pill" CornerRadius="22" Background="Transparent"/>
                        <Border x:Name="Hover" CornerRadius="22" Background="{DynamicResource StateHover}" Opacity="0"/>
                        <Border x:Name="Bar" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left" Margin="6,0,0,0"
                                Background="{DynamicResource Primary}" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" Margin="20,8,16,8" VerticalAlignment="Center">
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontFamily="{StaticResource FontIcons}" FontSize="{DynamicResource FsTitleMedium}"
                                       VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter x:Name="Text" Margin="14,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SecondaryContainer}"/>
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="compact">
                            <Setter TargetName="Text" Property="Visibility" Value="Collapsed"/>
                            <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NavList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value><ItemsPanelTemplate><DockPanel LastChildFill="False"/></ItemsPanelTemplate></Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Conteúdo das seções ============
         TabControl sem cabeçalhos (a navegação é a barra lateral). PART_SelectedContentHost é o nome que o
         TabControl usa para expor o conteúdo da aba ao Narrador e à UI Automation. -->
    <!-- O conteúdo de cada seção herda a cor do TabItem (pai lógico): sem isso vem o preto do sistema e some no tema escuro -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    </Style>
    <Style TargetType="TabControl">
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <TabPanel IsItemsHost="True" Visibility="Collapsed"/>
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="{TemplateBinding Padding}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Tabelas ============ -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="Transparent" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="0,0,0,1" Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <!-- Cabeçalho quebra em duas linhas entre palavras em vez de ser cortado ("Disco e rede / (KB/s)") -->
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Path x:Name="Arrow" Grid.Column="1" Visibility="Collapsed" Margin="6,0,0,0" VerticalAlignment="Center"
                                  Fill="{DynamicResource OnSurfaceVariant}" Data="M0,4 L4,0 L8,4 Z"/>
                            <Thumb x:Name="PART_RightHeaderGripper" Grid.ColumnSpan="2" HorizontalAlignment="Right" Width="6" Cursor="SizeWE">
                                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template>
                            </Thumb>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="Ascending"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleY="-1"/></Setter.Value></Setter>
                            <Setter TargetName="Arrow" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingTight}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="10,0" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingTight}"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" SnapsToDevicePixels="True">
                        <SelectiveScrollingGrid>
                            <SelectiveScrollingGrid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </SelectiveScrollingGrid.ColumnDefinitions>
                            <DataGridCellsPresenter Grid.Column="1" ItemsPanel="{TemplateBinding ItemsControl.ItemsPanel}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </SelectiveScrollingGrid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource StateHover}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryContainer}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- M26: menu de clique direito no tema do app (sem submenus) -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainer}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="12,8" MinWidth="200">
                        <DockPanel>
                            <!-- B30: marca de seleção nos itens marcáveis (escolha de colunas); some nos menus comuns -->
                            <TextBlock x:Name="Check" DockPanel.Dock="Left" Text="&#xE73E;" FontFamily="{StaticResource FontIcons}" FontSize="12"
                                       Width="22" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsCheckable" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource StateHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="8,4" Background="{DynamicResource OutlineVariant}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="MinRowHeight" Value="{DynamicResource RowMin}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <!-- ============ Barra de progresso linear ============
         Trilha contornada (Outline ≥ 3:1): a barra laranja continua legível sobre o cartão claro. -->
    <Style TargetType="ProgressBar">
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Height="8" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Outline}" Background="Transparent">
                        <Border x:Name="PART_Track" Margin="1">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{TemplateBinding Foreground}"/>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
