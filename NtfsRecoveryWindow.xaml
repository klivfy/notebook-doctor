<Window x:Class="NotebookDoctor.NtfsRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recuperar arquivos (motor do app)" Width="1180" Height="800" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource OnSurface}"
        FontFamily="{StaticResource FontBody}" FontSize="{DynamicResource FsBody}" UseLayoutRounding="True"
        AutomationProperties.Name="Recuperar arquivos (motor do app)">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Recuperar arquivos (motor do app)" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1"/>
        <TextBlock Grid.Row="1" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"
                   Text="O app lê a lista de arquivos (MFT) de uma unidade NTFS, mostra o que foi apagado e a chance de cada arquivo voltar inteiro, deixa você ver uma prévia e copia os que você marcar para OUTRA unidade. A unidade de origem só é lida, nunca gravada. Quanto antes você parar de usá-la, melhor."/>
        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <WrapPanel DockPanel.Dock="Right">
                <Button x:Name="ScanBtn" Content="Procurar apagados" Click="Scan_Click" Margin="8,0,0,0"/>
                <Button x:Name="CancelBtn" Content="Cancelar" Style="{StaticResource TonalButton}" Click="Cancel_Click" Visibility="Collapsed" Margin="8,0,0,0"/>
            </WrapPanel>
            <ComboBox x:Name="SourceBox" SelectionChanged="Source_Changed" AutomationProperties.Name="Unidade NTFS de onde recuperar"/>
        </DockPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <ProgressBar x:Name="Bar" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed" AutomationProperties.Name="Andamento"/>
            <TextBlock x:Name="Warn" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="4,4,0,0"/>
            <WrapPanel Margin="0,8,0,0">
                <TextBox x:Name="FilterBox" Width="260" Tag="Filtrar por nome ou pasta" TextChanged="Filter_Changed" Margin="0,0,12,8" AutomationProperties.Name="Filtrar por nome ou pasta"/>
                <CheckBox x:Name="OnlyGood" Content="Só os que têm chance" Click="Filter_Changed" VerticalAlignment="Center" Margin="0,0,12,8"
                          ToolTip="Esconde os que o app sabe que não voltam (apagados por cima, comprimidos, criptografados)."/>
                <Button Content="Marcar os de chance excelente" Style="{StaticResource TextButton}" Click="MarkBest_Click" Margin="0,0,8,8"/>
                <Button Content="Desmarcar todos" Style="{StaticResource TextButton}" Click="MarkNone_Click" Margin="0,0,8,8"/>
            </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="FilesGrid" AutomationProperties.Name="Arquivos apagados encontrados" SelectionMode="Single" SelectionChanged="Files_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Incluir" Width="Auto" MinWidth="88">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource GridCheck}" IsEnabled="{Binding CanSelect}"
                                          IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          AutomationProperties.Name="{Binding Name}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Pasta" Binding="{Binding FolderText}" Width="2*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeText}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Modificado" Binding="{Binding ModifiedText}" Width="130" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Chance" Binding="{Binding ChanceText}" Width="130" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="PreviewTitle" Text="Prévia" Style="{StaticResource CardTitle}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
                    <Grid Grid.Row="1" Margin="0,8">
                        <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed" AutomationProperties.Name="Prévia da imagem"/>
                        <TextBox x:Name="PreviewText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" AutomationProperties.Name="Prévia do texto"/>
                    </Grid>
                    <TextBlock x:Name="PreviewInfo" Grid.Row="2" Style="{StaticResource Label}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </Grid>
            </Border>
        </Grid>
        <TextBlock x:Name="Summary" Grid.Row="5" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="4,8,0,0" AutomationProperties.LiveSetting="Polite"/>
        <DockPanel Grid.Row="6" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Escolher…" Style="{StaticResource TonalButton}" Click="PickDest_Click" Margin="8,0,0,0"/>
            <Button x:Name="RecoverBtn" DockPanel.Dock="Right" Content="Recuperar os marcados…" Click="Recover_Click" Margin="8,0,0,0" IsEnabled="False"/>
            <TextBox x:Name="DestBox" Tag="Pasta de destino, em OUTRA unidade" AutomationProperties.Name="Pasta de destino"/>
        </DockPanel>
        <DockPanel Grid.Row="7" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Fechar" IsCancel="True" Click="Close_Click" Style="{StaticResource TextButton}"/>
            <TextBlock x:Name="Msg" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>
    </Grid>
</Window>
