<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>NotebookDoctor</AssemblyName>
    <RootNamespace>NotebookDoctor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>Notebook Doctor</Product>
    <Company>Klivfy Tecnologia e Consultoria em TI LTDA</Company>
    <Copyright>© 2026 Klivfy Tecnologia e Consultoria em TI LTDA. Todos os direitos reservados.</Copyright>
    <Description>Monitor de desempenho, limpeza segura e diagnóstico para Windows</Description>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- O app fica na raiz; a biblioteca e os testes têm projeto próprio e não entram na compilação dele -->
    <Compile Remove="src/**;tests/**" />
    <None Remove="src/**;tests/**" />
    <Page Remove="src/**;tests/**" />
    <ProjectReference Include="src/NotebookDoctor.Core/NotebookDoctor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Uma parte do MainWindow por aba; aparecem agrupadas sob MainWindow.xaml no Visual Studio -->
    <Compile Update="MainWindow.*.cs" DependentUpon="MainWindow.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="icon-256.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Google Sans Flex (SIL OFL) embutida no executável: o app não depende da fonte instalada -->
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms só é usado para o NotifyIcon da bandeja; evita ambiguidade com WPF -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
