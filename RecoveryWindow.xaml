<Window x:Class="NotebookDoctor.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recuperar arquivos" Width="900" Height="760" MinWidth="720" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource OnSurface}"
        FontFamily="{StaticResource FontBody}" FontSize="{DynamicResource FsBody}" UseLayoutRounding="True"
        AutomationProperties.Name="Recuperar arquivos">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="24">
            <TextBlock Text="Recuperar arquivos apagados" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"
                       Text="Usa o Windows File Recovery (winfr), gratuito e da Microsoft, que lê a unidade e grava os arquivos que achar numa pasta de OUTRA unidade. Nem sempre dá para recuperar tudo, e quanto antes você parar de usar a unidade, melhor."/>

            <TextBlock Text="De onde recuperar" Margin="0,0,0,4"/>
            <ComboBox x:Name="SourceBox" Width="620" HorizontalAlignment="Left" SelectionChanged="Source_Changed" AutomationProperties.Name="Unidade de onde recuperar"/>

            <TextBlock Text="Onde guardar o que for recuperado (outra unidade)" Margin="0,16,0,4"/>
            <DockPanel Width="620" HorizontalAlignment="Left">
                <Button DockPanel.Dock="Right" Content="Escolher…" Style="{StaticResource TonalButton}" Click="PickDest_Click" Margin="8,0,0,0"/>
                <TextBox x:Name="DestBox" AutomationProperties.Name="Pasta de destino"/>
            </DockPanel>

            <TextBlock Text="Como procurar" Margin="0,16,0,4"/>
            <ComboBox x:Name="ModeBox" Width="620" HorizontalAlignment="Left" SelectionChanged="Mode_Changed" AutomationProperties.Name="Modo de recuperação">
                <ComboBoxItem Tag="Regular" Content="Rápido: arquivos apagados há pouco (só NTFS)"/>
                <ComboBoxItem Tag="Extensive" Content="Profundo: qualquer sistema de arquivos, demora mais"/>
                <ComboBoxItem Tag="Signature" Content="Por assinatura: último recurso, acha pelo conteúdo e sem nomes"/>
            </ComboBox>

            <TextBlock Text="O que procurar" Margin="0,16,0,4"/>
            <WrapPanel>
                <CheckBox x:Name="TypeDocs" Content="Documentos" Margin="0,0,16,8" IsChecked="True"/>
                <CheckBox x:Name="TypePhotos" Content="Fotos" Margin="0,0,16,8" IsChecked="True"/>
                <CheckBox x:Name="TypeVideos" Content="Vídeos" Margin="0,0,16,8"/>
                <CheckBox x:Name="TypeAudio" Content="Músicas e áudios" Margin="0,0,16,8"/>
                <CheckBox x:Name="TypeArchives" Content="Compactados" Margin="0,0,16,8"/>
            </WrapPanel>
            <TextBox x:Name="FiltersBox" Width="620" HorizontalAlignment="Left" Tag="Outros filtros (opcional), separados por ponto e vírgula: relatorio*.docx; \Users\ana\Documents\"
                     AutomationProperties.Name="Outros filtros"/>

            <TextBlock x:Name="WarnInfo" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="4,16,0,0"/>

            <StackPanel Margin="0,16,0,0">
                <ProgressBar x:Name="Bar" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed" AutomationProperties.Name="Andamento"/>
                <TextBlock x:Name="LastLine" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="Msg" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
            <WrapPanel Margin="0,12,0,0">
                <Button x:Name="RunBtn" Content="Recuperar…" Click="Run_Click" Margin="0,0,8,8"/>
                <Button x:Name="EngineBtn" Content="Motor do app (NTFS, com prévia)…" Style="{StaticResource TonalButton}" Click="Engine_Click" Margin="0,0,8,8"
                        ToolTip="Em vez do Windows File Recovery, o próprio app lê a lista de arquivos do NTFS, mostra o que foi apagado, a chance de cada arquivo e uma prévia."/>
                <Button x:Name="CancelBtn" Content="Cancelar" Style="{StaticResource TonalButton}" Click="Cancel_Click" Visibility="Collapsed" Margin="0,0,8,8"/>
                <Button x:Name="OpenBtn" Content="Abrir a pasta recuperada" Style="{StaticResource TonalButton}" Click="Open_Click" Visibility="Collapsed" Margin="0,0,8,8"/>
                <Button Content="Fechar" Style="{StaticResource TextButton}" IsCancel="True" Click="Close_Click" Margin="0,0,8,8"/>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
