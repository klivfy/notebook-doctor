<Window x:Class="NotebookDoctor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NotebookDoctor"
        Title="Notebook Doctor" Icon="app.ico" Width="1160" Height="740" MinWidth="720" MinHeight="560"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource OnSurface}"
        FontFamily="{StaticResource FontBody}" FontSize="{DynamicResource FsBody}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen" SourceInitialized="Window_SourceInitialized" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- Navegação lateral: as seções do app; Configurações fica no rodapé (padrão do Windows 11) -->
        <Border x:Name="NavPane" Grid.RowSpan="3" Padding="10,14,10,12" MinWidth="200">
            <ListBox x:Name="Nav" Style="{StaticResource NavList}" AutomationProperties.Name="Seções"
                     SelectedIndex="{Binding SelectedIndex, ElementName=Tabs, Mode=TwoWay}">
                <ListBoxItem Tag="&#xE80F;" Content="Painel"/>
                <ListBoxItem Tag="&#xE8FD;" Content="Processos"/>
                <ListBoxItem Tag="&#xE74D;" Content="Limpeza"/>
                <ListBoxItem Tag="&#xEDA2;" Content="Espaço"/>
                <ListBoxItem Tag="&#xE71D;" Content="Programas"/>
                <ListBoxItem Tag="&#xE7E8;" Content="Inicialização"/>
                <ListBoxItem Tag="&#xE81C;" Content="Histórico"/>
                <ListBoxItem Tag="&#xE7A7;" Content="Ações"/>
                <ListBoxItem Tag="&#xE9E9;" Content="Ajustes"/>
                <ListBoxItem Tag="&#xE713;" Content="Configurações" DockPanel.Dock="Bottom"/>
            </ListBox>
        </Border>

        <!-- Cabeçalho da seção: onde estou, estado do PC e suporte -->
        <Grid Grid.Column="1" Margin="12,18,24,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="PageTitle" Text="{Binding SelectedItem.Header, ElementName=Tabs}" Style="{StaticResource TitleLarge}"
                           AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock x:Name="SubTitle" Text="Monitor de desempenho" Style="{StaticResource Label}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SimChip" Content="Simulação ligada" Style="{StaticResource TonalButton}" Visibility="Collapsed" Click="SimChip_Click"
                        ToolTip="Nenhuma correção altera o computador enquanto a simulação estiver ligada. Clique para ver em Ajustes."/>
                <Button Content="Suporte" Style="{StaticResource TextButton}" Click="Support_Click" ToolTip="Abrir klivfy.com/suporte"/>
                <Border x:Name="StatusChip" CornerRadius="8" Padding="14,7" Background="{DynamicResource SurfaceVariant}" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="Analisando…" FontFamily="{StaticResource FontMedium}" Foreground="{DynamicResource OnSurface}"
                               AutomationProperties.LiveSetting="Polite"/>
                </Border>
            </StackPanel>
        </Grid>

        <TabControl x:Name="Tabs" Grid.Column="1" Grid.Row="1" Margin="6,0,18,6" SelectionChanged="Tabs_SelectionChanged">

            <!-- PAINEL: nota de saúde primeiro, métricas compactas, diagnóstico com as correções -->
            <TabItem Header="Painel">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel x:Name="PainelContent">
                        <!-- Alerta de programa pesado (A41) -->
                        <Border x:Name="HeavyBanner" Style="{StaticResource Card}" Visibility="Collapsed"
                                Background="{DynamicResource SecondaryContainer}" Padding="18,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="HeavyTitle" FontFamily="{StaticResource FontMedium}" TextWrapping="Wrap" Foreground="{DynamicResource OnSecondaryContainer}"
                                               AutomationProperties.LiveSetting="Assertive"/>
                                    <TextBlock x:Name="HeavySub" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Ignorar por 1 h" Style="{StaticResource TextButton}" Click="HeavyIgnore_Click"/>
                                    <Button Content="Encerrar" Style="{StaticResource DangerButton}" Margin="0" Click="HeavyKill_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Nota de saúde: o elemento-assinatura (número grande + pulso da própria nota) -->
                        <Border Style="{StaticResource Card}" Padding="24,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="Nota de saúde" Style="{StaticResource Label}" ToolTip="De 0 a 100. Junta uso de CPU e memória, espaço livre, saúde do disco e da bateria e problemas encontrados. 75 ou mais é bom." AutomationProperties.HelpText="De 0 a 100. Junta uso de CPU e memória, espaço livre, saúde do disco e da bateria e problemas encontrados. 75 ou mais é bom."/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="ScoreText" Text="–" FontFamily="{StaticResource FontDisplay}" FontSize="{DynamicResource FsHero}"/>
                                        <TextBlock Text="/100" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="4,0,0,12"/>
                                    </StackPanel>
                                    <Border x:Name="ScoreChip" CornerRadius="8" Padding="10,4" HorizontalAlignment="Left" Background="{DynamicResource SurfaceVariant}">
                                        <TextBlock x:Name="ScoreLabel" Text="Calculando…" FontFamily="{StaticResource FontSemi}" FontSize="{DynamicResource FsLabel}"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                    <TextBlock Text="Gargalo agora" Style="{StaticResource Label}" ToolTip="O recurso que mais limita o computador neste momento, pelos últimos minutos de uso." AutomationProperties.HelpText="O recurso que mais limita o computador neste momento, pelos últimos minutos de uso."/>
                                    <TextBlock x:Name="BottleneckName" Style="{StaticResource Value}"/>
                                    <TextBlock x:Name="BottleneckText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <local:Sparkline x:Name="ScoreSpark" Height="40" Margin="0,12,0,0" Unit="" Title="Nota de saúde, última hora"
                                                     Stroke="{DynamicResource OnSurfaceVariant}" GridBrush="{DynamicResource OutlineVariant}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Top" MinWidth="170">
                                    <Button x:Name="OptimizeBtn" Content="Otimizar agora" Margin="0" Click="Optimize_Click"
                                            ToolTip="Limpa temporários antigos com segurança. Não apaga documentos, downloads nem a Lixeira."/>
                                    <Button x:Name="FocusBtn" Content="Modo Foco" Style="{StaticResource TonalButton}" Margin="0,8,0,0" Click="Focus_Click"
                                            ToolTip="Dá prioridade ao programa em uso: abaixa a prioridade dos pesados em segundo plano e ativa Alto desempenho, se existir. Nada é fechado; tudo volta ao desligar."/>
                                    <Button Content="Exportar relatório" Style="{StaticResource TextButton}" Margin="0,4,0,0" Click="Export_Click"
                                            ToolTip="Relatório em HTML, que abre no navegador"/>
                                    <Button Content="Exportar em PDF" Style="{StaticResource TextButton}" Margin="0,0,0,0" Click="ExportPdf_Click"
                                            ToolTip="O mesmo relatório em PDF, para anexar em e-mail ou chamado"/>
                                    <Button Content="Copiar resumo" Style="{StaticResource TextButton}" Margin="0,0,0,0" Click="CopySummary_Click"
                                            ToolTip="Copia nota, uso atual e problemas encontrados, para colar numa conversa ou chamado"/>
                                    <Button Content="Salvar imagem do painel" Style="{StaticResource TextButton}" Margin="0,0,0,0" Click="PainelImage_Click"
                                            ToolTip="Salva o painel inteiro em PNG e copia a imagem, para colar num chamado"/>
                                </StackPanel>

                                <!-- Fatos de saúde do hardware -->
                                <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,16,0,0">
                                    <StackPanel Margin="0,0,40,0">
                                        <TextBlock x:Name="DiskHealthTitle" Text="Disco · saúde" Style="{StaticResource Label}" ToolTip="Estado informado pelo próprio disco (SMART). Desgaste e temperatura do SSD aparecem com o app em modo administrador." AutomationProperties.HelpText="Estado informado pelo próprio disco (SMART). Desgaste e temperatura do SSD aparecem com o app em modo administrador."/>
                                        <TextBlock x:Name="DiskHealthText" Style="{StaticResource Value}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Bateria · tempo de inicialização" Style="{StaticResource Label}" ToolTip="Capacidade da bateria comparada à de fábrica e quanto o Windows levou para iniciar da última vez." AutomationProperties.HelpText="Capacidade da bateria comparada à de fábrica e quanto o Windows levou para iniciar da última vez."/>
                                        <TextBlock x:Name="BatteryBootText" Style="{StaticResource Value}"/>
                                    </StackPanel>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Métricas compactas: número, barra e gráfico numa faixa -->
                        <Border Style="{StaticResource Card}" Padding="20,16">
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,20,0">
                                    <DockPanel>
                                        <TextBlock x:Name="CpuText" Text="–" DockPanel.Dock="Right" FontFamily="{StaticResource FontMedium}" FontSize="{DynamicResource FsTitleLarge}"/>
                                        <TextBlock Text="Processador" Style="{StaticResource Label}" VerticalAlignment="Center" ToolTip="Quanto do processador está ocupado. Picos curtos são normais; acima de 85% por minutos seguidos deixa tudo lento." AutomationProperties.HelpText="Quanto do processador está ocupado. Picos curtos são normais; acima de 85% por minutos seguidos deixa tudo lento."/>
                                    </DockPanel>
                                    <ProgressBar x:Name="CpuBar" Margin="0,6,0,8" AutomationProperties.Name="Uso do processador"/>
                                    <local:Sparkline x:Name="CpuSpark" Height="32" Title="Processador, últimos minutos"
                                                     Stroke="{DynamicResource ChartCpu}" GridBrush="{DynamicResource OutlineVariant}"/>
                                    <TextBlock x:Name="CpuSub" Style="{StaticResource Label}" Text=" " TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,20,0">
                                    <DockPanel>
                                        <TextBlock x:Name="RamText" Text="–" DockPanel.Dock="Right" FontFamily="{StaticResource FontMedium}" FontSize="{DynamicResource FsTitleLarge}"/>
                                        <TextBlock Text="Memória" Style="{StaticResource Label}" VerticalAlignment="Center" ToolTip="Memória RAM em uso. Acima de 85%, o Windows começa a usar o disco como memória e fica lento." AutomationProperties.HelpText="Memória RAM em uso. Acima de 85%, o Windows começa a usar o disco como memória e fica lento."/>
                                    </DockPanel>
                                    <ProgressBar x:Name="RamBar" Margin="0,6,0,8" AutomationProperties.Name="Uso da memória"/>
                                    <local:Sparkline x:Name="RamSpark" Height="32" Title="Memória, últimos minutos"
                                                     Stroke="{DynamicResource ChartRam}" GridBrush="{DynamicResource OutlineVariant}"/>
                                    <TextBlock x:Name="RamSub" Style="{StaticResource Label}" Text=" " TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock x:Name="DiskText" Text="–" DockPanel.Dock="Right" FontFamily="{StaticResource FontMedium}" FontSize="{DynamicResource FsTitleLarge}"/>
                                        <TextBlock Text="Disco (atividade)" Style="{StaticResource Label}" VerticalAlignment="Center" ToolTip="Quanto do tempo o disco está ocupado lendo ou gravando. Perto de 100% por muito tempo trava abrir programas e arquivos." AutomationProperties.HelpText="Quanto do tempo o disco está ocupado lendo ou gravando. Perto de 100% por muito tempo trava abrir programas e arquivos."/>
                                    </DockPanel>
                                    <ProgressBar x:Name="DiskBar" Margin="0,6,0,8" AutomationProperties.Name="Atividade do disco"/>
                                    <local:Sparkline x:Name="DiskSpark" Height="32" Title="Atividade do disco, últimos minutos"
                                                     Stroke="{DynamicResource ChartDisk}" GridBrush="{DynamicResource OutlineVariant}"/>
                                    <TextBlock x:Name="DiskSub" Style="{StaticResource Label}" Text=" " TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <!-- Diagnóstico: o que está errado e o botão que resolve -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Diagnóstico" Style="{StaticResource TitleMedium}" AutomationProperties.HeadingLevel="Level2"/>
                                <ItemsControl x:Name="FindingsList" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Diagnóstico" Focusable="False" Grid.IsSharedSizeScope="True">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="104" SharedSizeGroup="Chip"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Border x:Name="Chip" CornerRadius="8" Padding="10,4" MinHeight="26" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                        Margin="0,0,12,0" Background="{DynamicResource Success}">
                                                    <TextBlock x:Name="ChipText" Text="{Binding Tag}" FontFamily="{StaticResource FontSemi}" FontSize="{DynamicResource FsLabel}"
                                                               Foreground="{DynamicResource OnSuccess}" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource FontMedium}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Advice}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    <ToggleButton x:Name="WhyToggle" Content="Por que isso importa?" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                                  Visibility="{Binding HasWhy, Converter={StaticResource B2V}}" Style="{StaticResource WhyToggle}"
                                                                  IsChecked="{Binding WhyOpen, Mode=OneWay}" Checked="WhyToggle_Changed" Unchecked="WhyToggle_Changed"
                                                                  AutomationProperties.HelpText="{Binding Title}"/>
                                                    <TextBlock Text="{Binding Why}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Visibility="{Binding IsChecked, ElementName=WhyToggle, Converter={StaticResource B2V}}"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="{Binding FixLabel}" Style="{StaticResource TonalButton}" Margin="12,0,0,0" VerticalAlignment="Top"
                                                        AutomationProperties.HelpText="{Binding Title}"
                                                        Visibility="{Binding HasFix, Converter={StaticResource B2V}}" Click="Fix_Click"/>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="PROBLEMA">
                                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Error}"/>
                                                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource OnError}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="ATENCAO">
                                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Warning}"/>
                                                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource OnWarning}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- PROCESSOS -->
            <TabItem Header="Processos">
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock Text="Programas em execução" Style="{StaticResource TitleMedium}" Margin="0,0,16,0"/>
                                <!-- M22 -->
                                <CheckBox x:Name="GroupByAppBox" Content="Juntar processos do mesmo aplicativo" Click="GroupByApp_Click" VerticalAlignment="Top"
                                          ToolTip="Ex.: Steam e steamwebhelper numa linha só. Encerrar, prioridade e modo eficiência valem para todos os processos da linha."/>
                            </StackPanel>
                            <TextBox x:Name="ProcSearch" Grid.Column="1" Tag="Buscar programa…" VerticalAlignment="Top" TextChanged="ProcSearch_Changed"
                                     AutomationProperties.Name="Buscar programa"/>
                        </Grid>
                        <!-- B33: totais do que está à vista (respeita a busca) -->
                        <DockPanel Grid.Row="1">
                            <TextBlock x:Name="ProcTotal" DockPanel.Dock="Bottom" Style="{StaticResource Label}" Margin="4,6,0,0" TextTrimming="CharacterEllipsis"/>
                            <DataGrid x:Name="ProcGrid" SelectionMode="Extended" MouseDoubleClick="ProcGrid_DoubleClick" PreviewKeyDown="ProcGrid_KeyDown" AutomationProperties.Name="Programas em execução">
                                <!-- M26: as mesmas ações dos botões, mais abrir o local e pesquisar o nome -->
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="_Detalhes" Click="ProcDetails_Click"/>
                                        <MenuItem Header="Abrir _local do arquivo" Click="ProcOpenLocation_Click"/>
                                        <MenuItem Header="_Pesquisar na internet o que é" Click="ProcSearchOnline_Click"/>
                                        <Separator/>
                                        <MenuItem Header="_Baixar prioridade" Click="LowerPriority_Click"/>
                                        <MenuItem Header="_Restaurar prioridade" Click="RestorePriority_Click"/>
                                        <MenuItem Header="Modo _eficiência" Click="Efficiency_Click"/>
                                        <MenuItem Header="_Não avisar sobre este" Click="AlertException_Click"/>
                                        <Separator/>
                                        <MenuItem Header="E_ncerrar…" Click="KillSelected_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <!-- Ícone, nome e, numa segunda linha, o que é o programa -->
                                    <DataGridTemplateColumn Header="Programa" Width="*" MinWidth="190" SortMemberPath="Name">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,6" ToolTip="{Binding About}" AutomationProperties.HelpText="{Binding SeverityText}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <!-- B32: barra na cor do peso (o número da coluna diz o mesmo) -->
                                                    <Border Width="4" CornerRadius="2" Margin="0,0,8,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="high"><Setter Property="Background" Value="{DynamicResource Error}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="mid"><Setter Property="Background" Value="{DynamicResource Warning}"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <Grid Grid.Column="1" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE7AC;" FontFamily="{StaticResource FontIcons}" Foreground="{DynamicResource OnSurfaceVariant}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image Source="{Binding Icon}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"
                                                               Visibility="{Binding HasIcon, Converter={StaticResource B2V}}"/>
                                                    </Grid>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource FontMedium}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding About}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Processos" Binding="{Binding Count}" Width="96" MinWidth="96"/>
                                    <DataGridTextColumn Header="CPU %" Binding="{Binding CpuPct, StringFormat=0.0}" Width="64" MinWidth="64"/>
                                    <DataGridTextColumn Header="Memória (MB)" Binding="{Binding MemMB, StringFormat=N0}" Width="92" MinWidth="92"/>
                                    <DataGridTextColumn Header="Disco e rede (KB/s)" Binding="{Binding IoKBs, StringFormat=N0}" Width="110" MinWidth="110"/>
                                    <DataGridTextColumn Header="Conexões" Binding="{Binding Conns}" Width="92" MinWidth="92"/>
                                    <DataGridTextColumn Header="Pode fechar?" Binding="{Binding SafetyText}" Width="130" MinWidth="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <WrapPanel Grid.Row="2" Margin="0,14,0,0">
                            <Button Content="Detalhes" Style="{StaticResource TonalButton}" Click="ProcDetails_Click" Margin="0,0,8,6"
                                    ToolTip="Cada processo do programa selecionado, com PID, memória e caminho (ou clique duplo na linha)."/>
                            <Button Content="Encerrar programa selecionado" Style="{StaticResource TonalButton}" Click="KillSelected_Click" Margin="0,0,8,6"/>
                            <Button Content="Baixar prioridade" Style="{StaticResource TextButton}" Click="LowerPriority_Click" Margin="0,0,8,6"
                                    ToolTip="O programa continua aberto, mas cede CPU aos demais. Reversível."/>
                            <Button Content="Restaurar prioridade" Style="{StaticResource TextButton}" Click="RestorePriority_Click" Margin="0,0,8,6"/>
                            <Button Content="Modo eficiência" Style="{StaticResource TextButton}" Click="Efficiency_Click" Margin="0,0,8,6"
                                    ToolTip="Como no Gerenciador de Tarefas: o programa continua aberto, mas roda devagar e econômico (bom para os que ficam em segundo plano). Desfaça em Ações."/>
                            <Button x:Name="ExceptionBtn" Content="Não avisar sobre este" Style="{StaticResource TextButton}" Click="AlertException_Click" Margin="0,0,8,6"
                                    ToolTip="O programa continua na lista, mas não gera mais avisos de uso alto. Desfaça em Configurações › Exceções."/>
                            <TextBlock x:Name="ProcMsg" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,6" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- LIMPEZA -->
            <TabItem Header="Limpeza">
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock x:Name="CleanHeader" Text="Clique em Analisar para ver o que pode ser removido." Style="{StaticResource TitleMedium}"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <DataGrid x:Name="CleanGrid" Grid.Row="1" PreviewKeyDown="CleanGrid_KeyDown" MouseDoubleClick="CleanPreview_Click" AutomationProperties.Name="Locais que podem ser limpos">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Limpar" Width="Auto" MinWidth="88">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource GridCheck}" IsEnabled="{Binding CanClean}"
                                                      IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      AutomationProperties.Name="{Binding Label}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Local" Binding="{Binding Label}" Width="*"/>
                                <DataGridTextColumn Header="Arquivos" Binding="{Binding Files, StringFormat=N0}" Width="110"/>
                                <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeText}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Grid.Row="2" Margin="0,14,0,0">
                            <Button Content="Analisar" Style="{StaticResource TonalButton}" Click="Scan_Click" Margin="0,0,8,6"/>
                            <Button Content="Limpar selecionados" Click="Clean_Click" Margin="0,0,8,6"/>
                            <!-- B35: o que seria apagado no local selecionado, sem apagar nada -->
                            <Button Content="Ver arquivos" Style="{StaticResource TonalButton}" Click="CleanPreview_Click" Margin="0,0,8,6"
                                    ToolTip="Lista o que a limpeza apagaria no local selecionado (clique duplo na linha faz o mesmo)."/>
                            <Button Content="Marcar todos" Style="{StaticResource TextButton}" Click="CleanSelectAll_Click" Margin="0,0,8,6"
                                    ToolTip="Marca todos os locais que podem ser limpos, menos a Lixeira (apagar dela é definitivo)"/>
                            <Button Content="Desmarcar todos" Style="{StaticResource TextButton}" Click="CleanSelectNone_Click" Margin="0,0,8,6"/>
                            <TextBlock x:Name="CleanMsg" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,6" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ESPAÇO (mapa de uso do disco) -->
            <TabItem Header="Espaço">
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="O que ocupa espaço no disco" Style="{StaticResource TitleMedium}"/>
                        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                            <ComboBox x:Name="SpaceMode" Width="210" Margin="0,0,12,6" SelectedIndex="0" SelectionChanged="SpaceMode_Changed" AutomationProperties.Name="O que analisar">
                                <ComboBoxItem Content="Pastas por tamanho" Tag="folders"/>
                                <ComboBoxItem Content="Maiores arquivos" Tag="large"/>
                                <ComboBoxItem Content="Arquivos duplicados" Tag="dupes"/>
                            </ComboBox>
                            <ComboBox x:Name="SpaceRoot" Width="270" Margin="0,0,12,6" SelectedIndex="0" AutomationProperties.Name="Onde analisar">
                                <ComboBoxItem Content="Minha pasta de usuário" Tag="user"/>
                                <ComboBoxItem Content="Dados de aplicativos (AppData)" Tag="appdata"/>
                                <ComboBoxItem Content="Disco inteiro (C:\) — demora" Tag="drive"/>
                            </ComboBox>
                            <Button x:Name="SpaceScanBtn" Content="Analisar" Click="SpaceScan_Click" Margin="0,0,8,6"/>
                            <Button x:Name="SpaceCancelBtn" Content="Cancelar" Style="{StaticResource TextButton}" Click="SpaceCancel_Click" IsEnabled="False" Margin="0,0,8,6"/>
                            <TextBox x:Name="SpaceSearch" Width="170" Tag="Filtrar…" VerticalAlignment="Center" TextChanged="SpaceSearch_Changed" Margin="0,0,0,6"
                                     AutomationProperties.Name="Filtrar resultados"/>
                        </WrapPanel>
                        <!-- B33: totais do que está à vista (respeita a busca) -->
                        <DockPanel Grid.Row="2">
                            <TextBlock x:Name="SpaceTotal" DockPanel.Dock="Bottom" Style="{StaticResource Label}" Margin="4,6,0,0" TextTrimming="CharacterEllipsis"/>
                            <DataGrid x:Name="SpaceGrid" AutomationProperties.Name="Resultado da análise de espaço">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="340">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Setter Property="ToolTip" Value="{Binding Path}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeText}" Width="110"/>
                                    <DataGridTemplateColumn Header="Proporção" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ProgressBar Value="{Binding Percent, Mode=OneWay}" Foreground="{DynamicResource ChartDisk}" Margin="0,0,12,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <WrapPanel Grid.Row="3" Margin="0,14,0,0">
                            <Button Content="Abrir local" Style="{StaticResource TonalButton}" Click="SpaceOpen_Click" Margin="0,0,8,6"/>
                            <Button Content="Ver programas instalados" Style="{StaticResource TextButton}" Click="SpacePrograms_Click" Margin="0,0,8,6"
                                    ToolTip="Tamanho, data e desinstalação de cada programa ficam na aba Programas."/>
                            <TextBlock x:Name="SpaceMsg" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,6" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"
                                       Text="Só leitura: nada é apagado aqui. Abra a pasta e decida o que remover."/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- PROGRAMAS (Fase 5): programas instalados, apps da Microsoft Store e atualizações do Windows -->
            <TabItem Header="Programas">
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Programas instalados" Style="{StaticResource TitleMedium}"/>
                        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                            <ComboBox x:Name="ProgFilter" Width="230" Margin="0,0,12,6" SelectedIndex="0" SelectionChanged="ProgFilter_Changed" AutomationProperties.Name="O que mostrar">
                                <ComboBoxItem Content="Programas" Tag="programs"/>
                                <ComboBoxItem Content="Apps da Microsoft Store" Tag="store"/>
                                <ComboBoxItem Content="Atualizações do Windows" Tag="updates"/>
                                <ComboBoxItem Content="Tudo" Tag="all"/>
                            </ComboBox>
                            <CheckBox x:Name="ProgSystemBox" Content="Mostrar componentes do sistema" Click="ProgSystem_Click" VerticalAlignment="Center" Margin="0,0,12,6"
                                      ToolTip="Inclui o que o Windows esconde da lista de aplicativos: partes de outros programas, atualizações de programas e apps do sistema."/>
                            <TextBox x:Name="ProgSearch" Width="220" Tag="Buscar programa…" VerticalAlignment="Center" TextChanged="ProgSearch_Changed" Margin="0,0,0,6"
                                     AutomationProperties.Name="Buscar programa"/>
                        </WrapPanel>
                        <!-- B33: totais do que está à vista (respeita a busca) -->
                        <DockPanel Grid.Row="2">
                            <TextBlock x:Name="ProgTotal" DockPanel.Dock="Bottom" Style="{StaticResource Label}" Margin="4,6,0,0" TextTrimming="CharacterEllipsis"/>
                            <DataGrid x:Name="ProgGrid" MouseDoubleClick="ProgGrid_DoubleClick" PreviewKeyDown="ProgGrid_KeyDown" AutomationProperties.Name="Programas instalados">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="_Desinstalar…" Click="ProgUninstall_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Abrir _pasta" Click="ProgOpenFolder_Click"/>
                                        <MenuItem Header="Abrir no _Editor do Registro" Click="ProgRegistry_Click"/>
                                        <MenuItem Header="Pe_squisar na internet" Click="ProgSearchOnline_Click"/>
                                        <Separator/>
                                        <MenuItem Header="P_ropriedades" Click="ProgProperties_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <!-- Ícone, nome e, numa segunda linha, o editor -->
                                    <DataGridTemplateColumn Header="Programa" Width="*" MinWidth="220" SortMemberPath="Name">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,6" ToolTip="{Binding Subtitle}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE7AC;" FontFamily="{StaticResource FontIcons}" Foreground="{DynamicResource OnSurfaceVariant}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image Source="{Binding Icon}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"
                                                               Visibility="{Binding HasIcon, Converter={StaticResource B2V}}"/>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource FontMedium}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Versão" Binding="{Binding Version}" Width="120"/>
                                    <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeText}" SortMemberPath="Bytes" Width="100"/>
                                    <DataGridTextColumn Header="Instalado em" Binding="{Binding InstallDateText}" SortMemberPath="InstallDate" Width="110"/>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding KindText}" Width="150"/>
                                    <DataGridTextColumn Header="Instalado para" Binding="{Binding ScopeText}" Width="140"/>
                                    <DataGridTextColumn Header="Arquitetura" Binding="{Binding BitsText}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <WrapPanel Grid.Row="3" Margin="0,14,0,0">
                            <Button Content="Desinstalar…" Click="ProgUninstall_Click" Margin="0,0,8,6"
                                    ToolTip="Abre o desinstalador do próprio programa (Delete na lista)."/>
                            <Button Content="Abrir pasta" Style="{StaticResource TonalButton}" Click="ProgOpenFolder_Click" Margin="0,0,8,6"/>
                            <Button Content="Propriedades" Style="{StaticResource TextButton}" Click="ProgProperties_Click" Margin="0,0,8,6"
                                    ToolTip="Tudo o que o programa registrou: pasta, comando de desinstalação, chave do registro (ou Enter na lista)."/>
                            <Button Content="Exportar lista…" Style="{StaticResource TextButton}" Click="ProgExport_Click" Margin="0,0,8,6"
                                    ToolTip="Salva a lista à vista (com a busca e o filtro) em CSV, para planilha, ou em HTML."/>
                            <Button Content="Atualizar" Style="{StaticResource TextButton}" Click="ProgRefresh_Click" Margin="0,0,8,6"/>
                            <TextBlock x:Name="ProgMsg" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,6" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- INICIALIZAÇÃO -->
            <TabItem Header="Inicialização">
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Programas que iniciam junto com o Windows" Style="{StaticResource TitleMedium}"/>
                            <TextBox x:Name="StartupSearch" Grid.Column="1" Tag="Buscar…" VerticalAlignment="Top" TextChanged="StartupSearch_Changed"
                                     AutomationProperties.Name="Buscar na inicialização"/>
                        </Grid>
                        <!-- B33: totais do que está à vista (respeita a busca) -->
                        <DockPanel Grid.Row="1">
                            <TextBlock x:Name="StartupTotal" DockPanel.Dock="Bottom" Style="{StaticResource Label}" Margin="4,6,0,0" TextTrimming="CharacterEllipsis"/>
                            <DataGrid x:Name="StartupGrid" AutomationProperties.Name="Programas de inicialização">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="170"/>
                                    <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="100"/>
                                    <DataGridTextColumn Header="Impacto estimado" Binding="{Binding Impact}" Width="250">
                                        <!-- B32: impacto alto em semi-negrito (vermelho em texto não teria contraste no tema escuro) -->
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="high">
                                                        <Setter Property="FontFamily" Value="{StaticResource FontSemi}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Editor" Binding="{Binding Publisher}" Width="200"/>
                                    <DataGridTextColumn Header="Comando" Binding="{Binding Command}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <WrapPanel Grid.Row="2" Margin="0,14,0,0">
                            <Button Content="Ativar / Desativar selecionado" Click="ToggleStartup_Click" Margin="0,0,8,6"/>
                            <Button Content="Abrir local" Style="{StaticResource TonalButton}" Click="StartupOpen_Click" Margin="0,0,8,6"
                                    ToolTip="Abre a pasta do programa com o arquivo selecionado"/>
                            <Button Content="Atualizar" Style="{StaticResource TextButton}" Click="RefreshStartup_Click" Margin="0,0,8,6"/>
                            <TextBlock x:Name="StartupMsg" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,6" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- HISTÓRICO -->
            <TabItem Header="Histórico">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock Text="Período" VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource Muted}"/>
                                    <ComboBox x:Name="PeriodBox" Width="190" SelectedIndex="0" SelectionChanged="Period_Changed" AutomationProperties.Name="Período">
                                        <ComboBoxItem Content="Últimas 24 horas"/>
                                        <ComboBoxItem Content="Últimos 7 dias"/>
                                        <ComboBoxItem Content="Últimos 30 dias"/>
                                    </ComboBox>
                                    <TextBlock x:Name="HistInfo" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,16,0"/>
                                    <Button Content="Exportar CSV" Style="{StaticResource TextButton}" Click="ExportCsv_Click"
                                            ToolTip="Salva o período escolhido em Documentos › Notebook Doctor, pronto para abrir no Excel."/>
                                </WrapPanel>
                                <TextBlock x:Name="HCpuLabel" Text="CPU" Margin="0,20,0,4" FontFamily="{StaticResource FontMedium}"/>
                                <local:Sparkline x:Name="HCpu" Zoomable="True" Height="70" Title="CPU no período" Stroke="{DynamicResource ChartCpu}" GridBrush="{DynamicResource OutlineVariant}"/>
                                <TextBlock x:Name="HRamLabel" Text="Memória" Margin="0,20,0,4" FontFamily="{StaticResource FontMedium}"/>
                                <local:Sparkline x:Name="HRam" Zoomable="True" Height="70" Title="Memória no período" Stroke="{DynamicResource ChartRam}" GridBrush="{DynamicResource OutlineVariant}"/>
                                <TextBlock x:Name="HDiskLabel" Text="Espaço livre no disco" Margin="0,20,0,4" FontFamily="{StaticResource FontMedium}"/>
                                <local:Sparkline x:Name="HFree" Zoomable="True" Height="70" Title="Espaço livre no disco no período" Stroke="{DynamicResource ChartDisk}" GridBrush="{DynamicResource OutlineVariant}"/>
                                <TextBlock x:Name="HScoreLabel" Text="Nota de saúde" Margin="0,20,0,4" FontFamily="{StaticResource FontMedium}"/>
                                <local:Sparkline x:Name="HScore" Zoomable="True" Height="70" Unit="" Title="Nota de saúde no período" Stroke="{DynamicResource OnSurfaceVariant}" GridBrush="{DynamicResource OutlineVariant}"/>
                            </StackPanel>
                        </Border>
                        <!-- M48 e M50: comparação com a semana passada e previsão do disco -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Tendências" Style="{StaticResource TitleMedium}"/>
                                <TextBlock x:Name="HCompare" TextWrapping="Wrap" LineHeight="24"/>
                                <TextBlock x:Name="HDiskForecast" TextWrapping="Wrap" LineHeight="24" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- M49: em que dias e horários o PC costuma ficar sob carga (último mês) -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Quando o computador fica mais lento" Style="{StaticResource TitleMedium}"/>
                                <TextBlock x:Name="HHeatInfo" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                                    <Grid x:Name="HeatGrid" AutomationProperties.Name="Mapa de calor de lentidão por dia e hora"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Programas que mais pesaram no período" Style="{StaticResource TitleMedium}"/>
                                <TextBlock x:Name="HOffenders" TextWrapping="Wrap" LineHeight="24"/>
                            </StackPanel>
                        </Border>
                        <!-- M05: linha do tempo de um programa -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Linha do tempo de um programa" Style="{StaticResource TitleMedium}"/>
                                <WrapPanel>
                                    <ComboBox x:Name="ProcTimelineBox" Width="260" SelectionChanged="ProcTimeline_Changed" AutomationProperties.Name="Programa"/>
                                    <TextBlock x:Name="ProcTimelineInfo" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap"/>
                                </WrapPanel>
                                <TextBlock x:Name="PCpuLabel" Text="CPU" Margin="0,16,0,4" FontFamily="{StaticResource FontMedium}"/>
                                <local:Sparkline x:Name="PCpu" Zoomable="True" Height="60" Title="CPU do programa no período" Stroke="{DynamicResource ChartCpu}" GridBrush="{DynamicResource OutlineVariant}"/>
                                <TextBlock x:Name="PRamLabel" Text="Memória" Margin="0,16,0,4" FontFamily="{StaticResource FontMedium}"/>
                                <local:Sparkline x:Name="PRam" Zoomable="True" Height="60" Unit=" MB" Title="Memória do programa no período" Stroke="{DynamicResource ChartRam}" GridBrush="{DynamicResource OutlineVariant}"/>
                            </StackPanel>
                        </Border>
                        <!-- M46/M47: linha do tempo do período (avisos, ações do app, instalações e picos de uso) -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Linha do tempo do período" Style="{StaticResource TitleMedium}"/>
                                <TextBlock x:Name="AlertsEmpty" Text="Nada registrado no período." Style="{StaticResource Muted}"/>
                                <DataGrid x:Name="AlertsGrid" MaxHeight="320" AutomationProperties.Name="Linha do tempo do período">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Quando" Binding="{Binding TimeText}" Width="110"/>
                                        <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="130"/>
                                        <DataGridTextColumn Header="Evento" Binding="{Binding Title}" Width="200">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,6"/></Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Detalhe" Binding="{Binding Text}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,6"/></Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- AÇÕES (registro + desfazer) -->
            <TabItem Header="Ações">
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="O que o Notebook Doctor fez neste computador" Style="{StaticResource TitleMedium}"/>
                        <DataGrid x:Name="ActionsGrid" Grid.Row="1" AutomationProperties.Name="Registro de ações">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Quando" Binding="{Binding TimeText}" Width="110"/>
                                <DataGridTextColumn Header="Ação" Binding="{Binding Title}" Width="240"/>
                                <DataGridTextColumn Header="Detalhe" Binding="{Binding Detail}" Width="*"/>
                                <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Grid.Row="2" Margin="0,14,0,0">
                            <Button Content="Desfazer selecionada" Style="{StaticResource TonalButton}" Click="Undo_Click" Margin="0,0,8,6"/>
                            <TextBlock x:Name="ActionsMsg" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,6" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"
                                       Text="Limpezas e encerramentos são definitivos; planos de energia e inicialização podem ser revertidos."/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- AJUSTES DO WINDOWS (A31–A35) com simulação (A38) -->
            <TabItem Header="Ajustes">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel HorizontalAlignment="Left" MaxWidth="820">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Ajustes do Windows" Style="{StaticResource TitleMedium}" AutomationProperties.HeadingLevel="Level2"/>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="Cada ajuste explica por que importa e mostra exatamente o que muda antes de aplicar. Tudo pode ser desfeito na seção Ações."/>
                                <CheckBox x:Name="SimMode" Click="SimMode_Click"
                                          Content="Modo simulação: mostrar o que cada correção faria, sem alterar nada (vale para todo o app)"/>
                            </StackPanel>
                        </Border>
                        <!-- M30: serviços de terceiros que iniciam com o Windows -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Serviços de terceiros que iniciam com o Windows" Style="{StaticResource TitleMedium}" AutomationProperties.HeadingLevel="Level2"/>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="Serviços do próprio Windows não aparecem aqui. Em manual, o serviço continua instalado e o programa ainda pode iniciá-lo quando precisar; só deixa de abrir sozinho no boot."/>
                                <DataGrid x:Name="ServicesGrid" MaxHeight="320" AutomationProperties.Name="Serviços de terceiros">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Serviço" Binding="{Binding DisplayName}" Width="220"/>
                                        <DataGridTextColumn Header="Recomendação" Binding="{Binding Advice}" Width="140"/>
                                        <DataGridTextColumn Header="Por quê" Binding="{Binding Reason}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Mudar para manual" Click="ServiceManual_Click" Margin="0,0,8,6"/>
                                    <TextBlock x:Name="ServicesMsg" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,6" TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <!-- M29: tarefas agendadas de terceiros -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Tarefas agendadas de terceiros" Style="{StaticResource TitleMedium}" AutomationProperties.HeadingLevel="Level2"/>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="Programas que se agendam para rodar ao ligar, ao entrar ou em horários fixos. As tarefas do Windows não aparecem. Desativar não apaga a tarefa e pode ser desfeito na aba Ações."/>
                                <DataGrid x:Name="TasksGrid" MaxHeight="320" AutomationProperties.Name="Tarefas agendadas de terceiros">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tarefa" Binding="{Binding Name}" Width="200"/>
                                        <DataGridTextColumn Header="Quando roda" Binding="{Binding When}" Width="120"/>
                                        <DataGridTextColumn Header="Recomendação" Binding="{Binding Advice}" Width="130"/>
                                        <DataGridTextColumn Header="Por quê" Binding="{Binding Reason}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Programa" Binding="{Binding Command}" Width="200"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Desativar tarefa" Click="TaskDisable_Click" Margin="0,0,8,6"/>
                                    <Button Content="Atualizar" Style="{StaticResource TextButton}" Click="TasksRefresh_Click" Margin="0,0,8,6"/>
                                    <TextBlock x:Name="TasksMsg" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,6" TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <!-- M31: extensões de navegador -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Extensões de navegador" Style="{StaticResource TitleMedium}" AutomationProperties.HeadingLevel="Level2"/>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="Cada extensão gasta memória e pode deixar as páginas mais lentas. As mais pesadas ficam sempre carregadas e rodam em todos os sites. O navegador não informa a memória de cada uma; o peso é estimado pelo que a extensão pede. Para desativar ou remover, use a página de extensões do navegador."/>
                                <DataGrid x:Name="ExtensionsGrid" MaxHeight="320" AutomationProperties.Name="Extensões de navegador">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Extensão" Binding="{Binding Name}" Width="220"/>
                                        <DataGridTextColumn Header="Navegador" Binding="{Binding Browser}" Width="90"/>
                                        <DataGridTextColumn Header="Perfil" Binding="{Binding Profile}" Width="110"/>
                                        <DataGridTextColumn Header="Peso estimado" Binding="{Binding Weight}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Versão" Binding="{Binding Version}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Abrir extensões do navegador" Style="{StaticResource TonalButton}" Click="ExtensionsOpen_Click" Margin="0,0,8,6"
                                            ToolTip="Abre a página de extensões do navegador da linha selecionada (ou do primeiro da lista)."/>
                                    <Button Content="Atualizar" Style="{StaticResource TextButton}" Click="ExtensionsRefresh_Click" Margin="0,0,8,6"/>
                                    <TextBlock x:Name="ExtensionsMsg" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,6" TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <!-- M36/M37: o que apaga dados do Windows de vez fica separado da Limpeza -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Limpeza do sistema (administrador)" Style="{StaticResource TitleMedium}" AutomationProperties.HeadingLevel="Level2"/>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                                           Text="Estas limpezas apagam dados do Windows que não voltam e não aparecem em Ações para desfazer. Por isso ficam separadas da Limpeza e só funcionam com o app aberto como administrador."/>
                                <TextBlock Text="Pontos de restauração" FontFamily="{StaticResource FontMedium}" Margin="0,0,0,4" AutomationProperties.HeadingLevel="Level3"/>
                                <TextBlock x:Name="RestoreInfo" Style="{StaticResource Muted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                <WrapPanel Margin="0,8,0,16">
                                    <Button Content="Apagar os antigos (manter o mais recente)" Style="{StaticResource TonalButton}" Click="RestoreOld_Click" Margin="0,0,8,6"/>
                                    <Button Content="Verificar" Style="{StaticResource TextButton}" Click="SystemCleanupRefresh_Click" Margin="0,0,8,6"/>
                                </WrapPanel>
                                <TextBlock Text="Logs de eventos grandes" FontFamily="{StaticResource FontMedium}" Margin="0,0,0,4" AutomationProperties.HeadingLevel="Level3"/>
                                <TextBlock x:Name="EventLogsInfo" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
                                <DataGrid x:Name="EventLogsGrid" MaxHeight="220" AutomationProperties.Name="Logs de eventos grandes">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Log" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeText}" SortMemberPath="Bytes" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Limpar log selecionado" Style="{StaticResource DangerButton}" Click="EventLogClear_Click" Margin="0,0,8,6"/>
                                    <Button Content="Abrir Visualizador de Eventos" Style="{StaticResource TextButton}" Click="EventViewer_Click" Margin="0,0,8,6"
                                            ToolTip="Para salvar uma cópia de um log antes de limpar: clique direito no log › Salvar Todos os Eventos Como."/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <ItemsControl x:Name="TweaksList" Focusable="False" AutomationProperties.Name="Ajustes do Windows">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border x:Name="Badge" DockPanel.Dock="Right" CornerRadius="8" Padding="10,3" VerticalAlignment="Top" Background="{DynamicResource SurfaceVariant}">
                                                    <TextBlock x:Name="BadgeText" Text="{Binding Badge}" FontFamily="{StaticResource FontSemi}" FontSize="{DynamicResource FsLabel}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource TitleMedium}" Margin="0,0,12,4" AutomationProperties.HeadingLevel="Level3"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Current}" Style="{StaticResource Value}" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding Why}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="Admin" Text="{Binding AdminNote}" Style="{StaticResource Label}" Margin="0,6,0,0"/>
                                            <WrapPanel Margin="0,12,0,0">
                                                <Button Content="{Binding ActionLabel}" IsEnabled="{Binding CanApply}" Click="Tweak_Click" Margin="0,0,8,0"
                                                        AutomationProperties.HelpText="{Binding Title}"/>
                                                <Button Content="Simular" Style="{StaticResource TextButton}" Click="TweakSimulate_Click"
                                                        AutomationProperties.HelpText="{Binding Title}" ToolTip="Mostra o que seria alterado, sem mudar nada"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Recommended}" Value="True">
                                            <Setter TargetName="Badge" Property="Background" Value="{DynamicResource SecondaryContainer}"/>
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource OnSecondaryContainer}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding AdminNote}" Value="">
                                            <Setter TargetName="Admin" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- CONFIGURAÇÕES -->
            <TabItem Header="Configurações">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
               <StackPanel HorizontalAlignment="Left" MaxWidth="720">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Preferências" Style="{StaticResource TitleMedium}" AutomationProperties.HeadingLevel="Level2"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" MinWidth="210"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Tema" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CfgTheme" Grid.Column="1" AutomationProperties.Name="Tema">
                                <ComboBoxItem Content="Seguir o Windows" Tag="system"/>
                                <ComboBoxItem Content="Claro" Tag="light"/>
                                <ComboBoxItem Content="Escuro" Tag="dark"/>
                                <ComboBoxItem Content="Claro de dia, escuro à noite" Tag="schedule"/>
                            </ComboBox>
                        </Grid>
                        <!-- M13: idioma (vale ao reabrir) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" MinWidth="210"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Idioma" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CfgLanguage" Grid.Column="1" AutomationProperties.Name="Idioma" ToolTip="Vale ao reabrir o app.">
                                <ComboBoxItem Content="Automático (idioma do Windows)" Tag="auto"/>
                                <ComboBoxItem Content="Português (Brasil)" Tag="pt"/>
                                <ComboBoxItem Content="English" Tag="en"/>
                                <ComboBoxItem Content="Español" Tag="es"/>
                            </ComboBox>
                        </Grid>
                        <!-- B37: horários do tema automático -->
                        <WrapPanel Margin="0,0,0,8">
                            <TextBlock Text="No tema por horário: claro a partir das" VerticalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBox x:Name="CfgThemeLight" Width="70" Margin="8,0,8,6" VerticalAlignment="Center" AutomationProperties.Name="Início do tema claro"/>
                            <TextBlock Text="e escuro a partir das" VerticalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBox x:Name="CfgThemeDark" Width="70" Margin="8,0,0,6" VerticalAlignment="Center" AutomationProperties.Name="Início do tema escuro"/>
                        </WrapPanel>
                        <!-- B16/B17 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" MinWidth="210"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Tamanhos" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CfgSizeUnit" Grid.Column="1" AutomationProperties.Name="Unidade de tamanho">
                                <ComboBoxItem Content="GB, como o Windows (base 1024)" Tag="windows"/>
                                <ComboBoxItem Content="GB, como na caixa do disco (base 1000)" Tag="decimal"/>
                                <ComboBoxItem Content="GiB (base 1024)" Tag="binary"/>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Text="Temperatura" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <ComboBox x:Name="CfgTempUnit" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" AutomationProperties.Name="Unidade de temperatura">
                                <ComboBoxItem Content="Celsius (°C)" Tag="c"/>
                                <ComboBoxItem Content="Fahrenheit (°F)" Tag="f"/>
                            </ComboBox>
                        </Grid>
                        <!-- B21: ainda sem instalador, o próprio app cria o atalho, na pasta Programas do usuário -->
                        <WrapPanel Margin="0,0,0,8">
                            <Button x:Name="StartMenuBtn" Content="Adicionar ao Menu Iniciar" Style="{StaticResource TonalButton}" Click="StartMenu_Click" Margin="0,0,12,4"/>
                            <TextBlock x:Name="StartMenuMsg" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,4"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </WrapPanel>
                        <CheckBox x:Name="CfgStart" Content="Iniciar com o Windows (fica na bandeja)"/>
                        <CheckBox x:Name="CfgTrayCpu" Content="Mostrar o uso da CPU (%) no ícone da bandeja"/>
                        <CheckBox x:Name="CfgSounds" Content="Som discreto ao terminar uma limpeza"/>
                        <CheckBox x:Name="CfgStartMin" Content="Ao abrir pelo atalho, começar minimizado na barra de tarefas"/>
                        <CheckBox x:Name="CfgCloseExits" Content="Fechar a janela encerra o app (em vez de continuar na bandeja)"
                                  ToolTip="Desligado, o X só esconde a janela: os avisos e o histórico continuam funcionando."/>
                        <CheckBox x:Name="CfgCompact" Content="Modo compacto: menu só com ícones e tabelas mais densas, para telas pequenas"/>
                        <CheckBox x:Name="CfgAlerts" Content="Avisar quando CPU ou RAM ficarem altas"/>
                        <CheckBox x:Name="CfgToasts" Content="Usar notificações do Windows (com botões)"/>
                        <CheckBox x:Name="CfgWeekly" Content="Limpar temporários toda semana, com o PC parado"/>
                        <CheckBox x:Name="CfgRestore" Content="Criar ponto de restauração antes de mudar o sistema (só no modo administrador)"/>
                        <CheckBox x:Name="CfgMini" Content="Mini-widget sempre visível (CPU, memória e disco num canto da tela)"/>
                        <CheckBox x:Name="CfgUpdates" Content="Procurar nova versão uma vez por dia"/>
                        <!-- M03: overlay que não recebe clique nem foco, por cima de jogos e apps em tela cheia -->
                        <Grid Margin="0,8,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" MinWidth="210"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Overlay de desempenho (CPU, RAM e temperatura)" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                            <ComboBox x:Name="CfgOverlay" Grid.Column="1" AutomationProperties.Name="Overlay de desempenho"
                                      ToolTip="Jogos em tela cheia exclusiva podem cobrir o overlay; no modo janela sem bordas ele aparece.">
                                <ComboBoxItem Content="Desligado" Tag="off"/>
                                <ComboBoxItem Content="Em jogos e apps em tela cheia" Tag="fullscreen"/>
                                <ComboBoxItem Content="Sempre" Tag="always"/>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Text="Canto do overlay" VerticalAlignment="Center" Margin="0,8,12,0"/>
                            <ComboBox x:Name="CfgOverlayCorner" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" AutomationProperties.Name="Canto do overlay">
                                <ComboBoxItem Content="Superior esquerdo" Tag="top-left"/>
                                <ComboBoxItem Content="Superior direito" Tag="top-right"/>
                                <ComboBoxItem Content="Inferior esquerdo" Tag="bottom-left"/>
                                <ComboBoxItem Content="Inferior direito" Tag="bottom-right"/>
                            </ComboBox>
                        </Grid>
                        <!-- M19: opt-in; o relatório fica no PC e só sai no pacote de suporte que a pessoa anexar -->
                        <CheckBox x:Name="CfgCrash" Content="Guardar relatórios de falha, sem dados pessoais, para o pacote do suporte"
                                  ToolTip="Nada é enviado pela internet. Os relatórios ficam na pasta de dados do app e vão no pacote para o suporte."/>
                        <CheckBox x:Name="CfgHotkey" Content="Atalho Ctrl+Alt+N abre o painel de qualquer lugar"/>
                        <CheckBox x:Name="CfgAccent" Content="Usar a cor de destaque do Windows (ajustada para manter a leitura)"/>
                        <!-- M43/M44: sem notificações em tela cheia ou no horário escolhido (os avisos continuam no Histórico) -->
                        <CheckBox x:Name="CfgQuietFull" Content="Sem notificações com app em tela cheia, jogo ou apresentação"/>
                        <WrapPanel>
                            <CheckBox x:Name="CfgQuiet" Content="Horário silencioso, das" VerticalAlignment="Center"/>
                            <TextBox x:Name="CfgQuietStart" Width="70" Margin="8,0,8,6" VerticalAlignment="Center" AutomationProperties.Name="Início do horário silencioso"/>
                            <TextBlock Text="às" VerticalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBox x:Name="CfgQuietEnd" Width="70" Margin="8,0,0,6" VerticalAlignment="Center" AutomationProperties.Name="Fim do horário silencioso"/>
                        </WrapPanel>
                        <Grid Margin="0,16,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock x:Name="CfgDaysLabel" Text="Apagar temporários com mais de (dias)" VerticalAlignment="Center" Margin="0,0,12,10" TextWrapping="Wrap"/>
                            <TextBox x:Name="CfgDays" Grid.Column="1" Margin="0,0,0,10" AutomationProperties.LabeledBy="{Binding ElementName=CfgDaysLabel}"/>
                            <TextBlock x:Name="CfgCpuLabel" Text="Alerta de CPU a partir de (%)" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,12,10" TextWrapping="Wrap"/>
                            <TextBox x:Name="CfgCpu" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" AutomationProperties.LabeledBy="{Binding ElementName=CfgCpuLabel}"/>
                            <TextBlock x:Name="CfgRamLabel" Text="Alerta de RAM a partir de (%)" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,12,10" TextWrapping="Wrap"/>
                            <TextBox x:Name="CfgRam" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" AutomationProperties.LabeledBy="{Binding ElementName=CfgRamLabel}"/>
                            <TextBlock x:Name="CfgAlertMinLabel" Text="Avisar só depois de quantos minutos seguidos" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
                            <TextBox x:Name="CfgAlertMin" Grid.Row="3" Grid.Column="1" AutomationProperties.LabeledBy="{Binding ElementName=CfgAlertMinLabel}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Salvar" Click="SaveSettings_Click"/>
                            <TextBlock x:Name="CfgMsg" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Exceções (M20) e protegidos (M21) -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Exceções" Style="{StaticResource TitleMedium}" AutomationProperties.HeadingLevel="Level2"/>
                        <TextBlock Text="Um programa por linha, com ou sem .exe. Vale ao clicar em Salvar, no cartão Preferências." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <TextBlock x:Name="CfgExceptionsLabel" Text="Nunca avisar sobre estes programas (uso alto esperado, como edição de vídeo)" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBox x:Name="CfgExceptions" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                 Tag="ex.: Resolve" AutomationProperties.LabeledBy="{Binding ElementName=CfgExceptionsLabel}" Margin="0,0,0,14"/>
                        <TextBlock x:Name="CfgProtectedLabel" Text="Nunca oferecer encerrar nem baixar a prioridade destes (os do Windows já são protegidos)" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBox x:Name="CfgProtected" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                 Tag="ex.: Teams" AutomationProperties.LabeledBy="{Binding ElementName=CfgProtectedLabel}"/>
                    </StackPanel>
                </Border>

                <!-- Perfis -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Perfis" Style="{StaticResource TitleMedium}" AutomationProperties.HeadingLevel="Level2"/>
                        <TextBlock x:Name="ProfileDesc" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Button x:Name="ProfWork" Content="Trabalho" Tag="work" Click="Profile_Click" Margin="0,0,8,8"/>
                            <Button x:Name="ProfMeeting" Content="Reunião" Tag="meeting" Click="Profile_Click" Margin="0,0,8,8"/>
                            <Button x:Name="ProfBattery" Content="Bateria" Tag="battery" Click="Profile_Click" Margin="0,0,8,8"/>
                            <Button x:Name="ProfPerf" Content="Desempenho" Tag="performance" Click="Profile_Click" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Energia -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Plano de energia" Style="{StaticResource TitleMedium}" AutomationProperties.HeadingLevel="Level2"/>
                        <TextBlock Text="O plano Equilibrado reduz a velocidade do processador para economizar energia. Em notebook ligado na tomada, Alto desempenho deixa tudo mais ágil." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="PlanBox" Margin="0,0,12,0" AutomationProperties.Name="Plano de energia"/>
                            <Button Grid.Column="1" Content="Aplicar" Style="{StaticResource TonalButton}" Margin="0" Click="ApplyPlan_Click"/>
                        </Grid>
                        <WrapPanel>
                            <Button x:Name="CreateHighBtn" Content="Criar plano Alto desempenho" Style="{StaticResource TextButton}" Click="CreateHigh_Click"/>
                            <TextBlock x:Name="PlanMsg" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Administrador -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Permissões" Style="{StaticResource TitleMedium}" AutomationProperties.HeadingLevel="Level2"/>
                        <TextBlock x:Name="AdminText" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
                        <Button x:Name="AdminBtn" Content="Reiniciar como administrador" Style="{StaticResource TonalButton}" HorizontalAlignment="Left" Click="Admin_Click"/>
                    </StackPanel>
                </Border>

                <!-- Conexão de internet (A46) -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Conexão de internet" Style="{StaticResource TitleMedium}" AutomationProperties.HeadingLevel="Level2"/>
                        <TextBlock Text="Mede a latência até o roteador e a internet, a perda de pacotes e o tempo de DNS. Não mede velocidade de download (não gasta sua franquia)." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Button x:Name="NetTestBtn" Content="Testar conexão" Style="{StaticResource TonalButton}" HorizontalAlignment="Left" Click="NetTest_Click"/>
                        <TextBlock x:Name="NetTestResult" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="22" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Border>

                <!-- Integridade do sistema (SFC/DISM) -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Integridade do Windows" Style="{StaticResource TitleMedium}" AutomationProperties.HeadingLevel="Level2"/>
                        <TextBlock Text="Procura arquivos do Windows danificados com as ferramentas oficiais do sistema (SFC e DISM). Exige modo administrador e pode levar vários minutos. Verificar só lê; Reparar corrige arquivos do sistema." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <WrapPanel Margin="0,0,0,10">
                            <Button x:Name="IntegrityCheckBtn" Content="Verificar" Style="{StaticResource TonalButton}" Click="IntegrityCheck_Click"/>
                            <Button x:Name="IntegrityRepairBtn" Content="Reparar" Click="IntegrityRepair_Click"/>
                            <Button x:Name="IntegrityCancelBtn" Content="Cancelar" Style="{StaticResource TextButton}" Click="IntegrityCancel_Click" IsEnabled="False"/>
                        </WrapPanel>
                        <TextBox x:Name="IntegrityLog" Height="130" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="{DynamicResource FsLabel}"
                                 AutomationProperties.Name="Saída da verificação de integridade"/>
                    </StackPanel>
                </Border>

                <!-- M07/B42: levar as preferências para outro PC ou voltar ao padrão -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Backup das preferências" Style="{StaticResource TitleMedium}" AutomationProperties.HeadingLevel="Level2"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Exporta tema, avisos, exceções, protegidos e demais escolhas para um arquivo, para usar em outro computador. Histórico e registro de ações não entram."/>
                        <WrapPanel>
                            <Button Content="Exportar…" Style="{StaticResource TonalButton}" Click="ExportSettings_Click" Margin="0,0,8,8"/>
                            <Button Content="Importar…" Style="{StaticResource TonalButton}" Click="ImportSettings_Click" Margin="0,0,8,8"/>
                            <Button Content="Redefinir para o padrão" Style="{StaticResource TextButton}" Click="ResetSettings_Click" Margin="0,0,8,8"/>
                            <!-- B36 -->
                            <Button Content="Voltar a pedir todas as confirmações" Style="{StaticResource TextButton}" Click="ResetConfirms_Click" Margin="0,0,8,8"/>
                            <!-- B30 -->
                            <Button Content="Mostrar todas as colunas das tabelas" Style="{StaticResource TextButton}" Click="ShowAllColumns_Click" Margin="0,0,8,8"
                                    ToolTip="Volta a mostrar as colunas escondidas pelo clique direito no título das tabelas."/>
                        </WrapPanel>
                        <TextBlock x:Name="BackupMsg" Style="{StaticResource Muted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Border>

                <!-- B38: modo empresa -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Senha das configurações (modo empresa)" Style="{StaticResource TitleMedium}" AutomationProperties.HeadingLevel="Level2"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Com senha, salvar, importar ou redefinir as preferências, trocar de perfil, desligar o modo simulação e mudar &quot;Iniciar com o Windows&quot; pedem a senha. Depois de digitada, vale por 10 minutos. Ver, analisar e limpar continuam livres."/>
                        <TextBlock x:Name="LockState" FontFamily="{StaticResource FontMedium}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <StackPanel x:Name="LockEdit">
                            <WrapPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock x:Name="LockNewLabel" Text="Nova senha" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="LockNew" Width="200" AutomationProperties.LabeledBy="{Binding ElementName=LockNewLabel}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock x:Name="LockConfirmLabel" Text="Repita a nova senha" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="LockConfirm" Width="200" AutomationProperties.LabeledBy="{Binding ElementName=LockConfirmLabel}"/>
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel>
                                <Button x:Name="LockSetBtn" Content="Definir senha" Style="{StaticResource TonalButton}" Click="LockSet_Click" Margin="0,0,8,8"/>
                                <Button x:Name="LockRemoveBtn" Content="Remover senha" Style="{StaticResource TextButton}" Click="LockRemove_Click" Margin="0,0,8,8"/>
                                <Button x:Name="LockCopyBtn" Content="Copiar para a política do Windows" Style="{StaticResource TextButton}" Click="LockCopy_Click" Margin="0,0,8,8"
                                        ToolTip="Copia o código da senha (não a senha) para a TI gravar em HKLM\SOFTWARE\Policies\Klivfy\NotebookDoctor, valor SettingsLock. Assim a senha vale para todos os usuários e só um administrador remove."/>
                            </WrapPanel>
                        </StackPanel>
                        <Button x:Name="LockNowBtn" Content="Bloquear agora" Style="{StaticResource TextButton}" Click="LockNow_Click" HorizontalAlignment="Left" Margin="0,0,8,8"/>
                        <TextBlock x:Name="LockMsg" Style="{StaticResource Muted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Border>

                <!-- Sobre -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Sobre" Style="{StaticResource TitleMedium}" AutomationProperties.HeadingLevel="Level2"/>
                        <TextBlock x:Name="AboutText" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="Fonte Google Sans Flex, licença SIL Open Font License 1.1." Style="{StaticResource Label}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                        <!-- B23/B24: textos embutidos no app, abrem sem internet -->
                        <WrapPanel Margin="0,0,0,4">
                            <Button Content="Novidades" Style="{StaticResource TextButton}" Tag="Novidades" Click="AboutText_Click" Margin="0,0,8,8"/>
                            <Button Content="Seus dados e privacidade" Style="{StaticResource TextButton}" Tag="Privacidade" Click="AboutText_Click" Margin="0,0,8,8"/>
                            <Button Content="Licenças e créditos" Style="{StaticResource TextButton}" Tag="Licencas" Click="AboutText_Click" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="Abrir suporte" Click="Support_Click" Margin="0,0,8,8"/>
                            <Button Content="Exportar log de diagnóstico" Style="{StaticResource TextButton}" Click="DiagnosticLog_Click" Margin="0,0,8,8"
                                    ToolTip="Um .txt com diagnóstico, erros recentes, ações e avisos, sem nome de usuário nem do computador. Bom para colar num e-mail."/>
                            <Button Content="Gerar pacote para o suporte" Style="{StaticResource TonalButton}" Click="SupportPackage_Click" Margin="0,0,8,8"
                                    ToolTip="Cria um .zip só com dados técnicos (sem seu nome de usuário nem o nome do computador) para anexar no atendimento."/>
                            <Button x:Name="UpdateBtn" Content="Procurar atualização" Style="{StaticResource TextButton}" Click="CheckUpdate_Click" Margin="0,0,8,8"/>
                            <Button Content="Abrir pasta de dados" Style="{StaticResource TextButton}" Click="OpenData_Click" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <TextBlock x:Name="UpdateMsg" Style="{StaticResource Muted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Border>
               </StackPanel>
              </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Aviso flutuante (snackbar): resultado de ações, sem diálogo modal -->
        <Border x:Name="Snack" Grid.Column="1" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="24,0,24,20" MaxWidth="640" CornerRadius="8" Padding="18,12,6,12" Background="{DynamicResource InverseSurface}">
            <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.3"/></Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SnackTitle" FontFamily="{StaticResource FontMedium}" Foreground="{DynamicResource InverseOnSurface}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive"/>
                    <TextBlock x:Name="SnackText" Foreground="{DynamicResource InverseOnSurface}" Opacity="0.85" TextWrapping="Wrap" Margin="0,2,0,0"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <Button x:Name="SnackAction" Grid.Column="1" Style="{StaticResource TextButton}" Foreground="{DynamicResource InversePrimary}"
                        Visibility="Collapsed" Margin="12,0,0,0" VerticalAlignment="Center" Click="SnackAction_Click"/>
                <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconButton}" Foreground="{DynamicResource InverseOnSurface}"
                        Margin="4,0,0,0" VerticalAlignment="Top" AutomationProperties.Name="Fechar aviso" ToolTip="Fechar" Click="SnackClose_Click"/>
            </Grid>
        </Border>

        <!-- Rodapé discreto -->
        <TextBlock Grid.Column="1" Grid.Row="2" x:Name="FooterText" Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="12,0,12,10"
                   TextTrimming="CharacterEllipsis" ToolTip="Notebook Doctor"/>
    </Grid>
</Window>
